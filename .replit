modules = ["web", "nodejs-24", "python-base-3.13", "postgresql-16"]

# Run button: dev server with live reload on port 5000 (Webview).
run = "cd site && npm install --no-audit --no-fund && npm run dev"

hidden = [".config", "site/node_modules", "site/dist", "site/.astro"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "cd site && npm ci --include=dev --no-audit --no-fund && npm run build"]
run = ["sh", "-c", "cd site && npm start"]

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd site && npm ci --include=dev --no-audit --no-fund && npm run dev"
waitForPort = 5000

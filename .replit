# Replit configuration for the Eichenberg & Associates site.
# The app lives in site/ (Astro 4, Node adapter). Data lives in Replit's built-in PostgreSQL (DATABASE_URL).
modules = ["nodejs-20", "postgresql-16"]

# Run button: dev server with live reload on port 5000 (Webview).
run = "cd site && npm install --no-audit --no-fund && npm run dev"

hidden = [".config", "site/node_modules", "site/dist", "site/.astro"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "cd site && npm ci --include=dev --no-audit --no-fund && npm run build"]
run = ["sh", "-c", "cd site && npm start"]

[[ports]]
localPort = 5000
externalPort = 80

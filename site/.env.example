# Copy to .env for local development. On Replit, put these in Secrets instead (the padlock icon), never in a file.
# DATABASE_URL is added for you when you create the PostgreSQL database in Replit.

# Database (required)
DATABASE_URL=                         # postgres://user:password@host:5432/dbname

# First sign-in (used once, on first boot, when no dashboard users exist yet)
ADMIN_EMAIL=jennifer@eichenbergassociates.com
ADMIN_PASSWORD=                       # at least 10 characters; change it after the first sign-in
ADMIN_NAME=Jennifer Eichenberg

# Public
PUBLIC_SITE_URL=https://eichenbergassociates.com
PUBLIC_TURNSTILE_SITE_KEY=            # Cloudflare Turnstile (free) — site key
PUBLIC_PLAUSIBLE_DOMAIN=              # optional: eichenbergassociates.com (leave blank to disable analytics)

# Server only
TURNSTILE_SECRET_KEY=
# Email (SendGrid). Guide: docs/email-sendgrid.md. Test at Dashboard → Settings → Email delivery, or `npm run mail:test -- you@x.com`.
SENDGRID_API_KEY=                     # SG.… — restricted key with "Mail Send" access only (add "Marketing" only if NEWSLETTER_PROVIDER=sendgrid)
CONTACT_FROM_EMAIL=noreply@eichenbergassociates.com   # verified sender in SendGrid; what visitors see as "From"
CONTACT_FROM_NAME=Eichenberg & Associates             # display name next to the from address
CONTACT_REPLY_TO=support@eichenbergassociates.com     # where replies to the thank-you and reset emails go (must be a real, watched inbox)
CONTACT_TO_EMAIL=jennifer@eichenbergassociates.com    # one address that gets the new-lead / new-inquiry notifications
SENDGRID_SANDBOX=                     # true = SendGrid checks the request but delivers nothing (dev workspace only; never in the deployment)
RESEND_API_KEY=                       # legacy fallback, used only when SENDGRID_API_KEY is empty
NEWSLETTER_PROVIDER=none              # none | buttondown | sendgrid | resend-audience
BUTTONDOWN_API_KEY=
SENDGRID_LIST_ID=                     # optional, with NEWSLETTER_PROVIDER=sendgrid: Marketing → Lists → the list's ID
RESEND_AUDIENCE_ID=
CALENDLY_URL=                         # default booking link for the persona landing pages (first boot only)

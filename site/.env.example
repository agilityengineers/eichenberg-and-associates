# Public
PUBLIC_SITE_URL=https://eichenbergassociates.com
PUBLIC_TURNSTILE_SITE_KEY=            # Cloudflare Turnstile (free) — site key
PUBLIC_PLAUSIBLE_DOMAIN=              # optional: eichenbergassociates.com (leave blank to disable analytics)

# Server only — never prefix with PUBLIC_
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=                       # resend.com — transactional email
CONTACT_TO_EMAIL=jennifer@eichenbergassociates.com
CONTACT_FROM_EMAIL=website@eichenbergassociates.com   # must be a verified Resend sender/domain
NEWSLETTER_PROVIDER=none              # none | buttondown | resend-audience
BUTTONDOWN_API_KEY=
RESEND_AUDIENCE_ID=

# Supabase (leads, pipeline, form builder, dashboard auth)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only
ADMIN_EMAILS=jennifer@eichenbergassociates.com   # comma-separated allowlist for /dashboard
CALENDLY_URL=                         # default booking link used by the seed script

---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { getDocs, md, page } from '../../lib/content';
import { si, siRaw } from '../../lib/si';
const s = (await getDocs('services')).find((d) => d.slug === Astro.params.slug);
if (!s) return new Response(null, { status: 404 });
const labels = await page('services');
const ld = { '@context': 'https://schema.org', '@type': 'Service', name: s.data.title, description: s.data.lead, provider: { '@type': 'ProfessionalService', name: 'Eichenberg & Associates' }, serviceType: 'Organizational change management' };
---
<Base title={s.data.title} description={s.data.summary} jsonLd={ld}>
  <section class="wrap grid" style="padding-top:clamp(64px,8vw,112px);padding-bottom:clamp(64px,8vw,104px)">
    <div><p class="eyebrow eyebrow--teal rise">{s.data.when}</p><h1 class="display word" style="font-size:clamp(44px,6.4vw,88px);animation-delay:.1s">{s.data.title}</h1><p class="lead rise" style="margin-top:28px;max-width:40ch;animation-delay:.3s" set:html={si(s.data.lead)} />{s.data.showPrice && <p style="margin:24px 0 0;font-size:15px;font-weight:600">{s.data.price}</p>}</div>
    <div style="display:grid;gap:28px;align-content:start">
      <div><h2 class="label" style="margin:0 0 12px">{labels.whoLabel}</h2><p style="margin:0;font-size:17px;line-height:1.55" set:html={si(s.data.who)} /></div>
      <div><h2 class="label" style="margin:0 0 12px">{labels.getLabel}</h2><ul style="margin:0;padding-left:20px;display:grid;gap:8px;font-size:17px;line-height:1.5">{(s.data.points || []).map((p: string) => <li set:html={si(p)} />)}</ul></div>
      <blockquote class="quote" style="border-radius:8px" set:html={si(s.data.message)} />
      {s.body && <div class="prose" set:html={md(siRaw(s.body))} />}
      <a href="/contact" class="btn btn--navy" style="justify-self:start;padding:14px 22px;font-size:15px">{s.data.cta}</a>
    </div>
  </section>
  <Cta />
</Base>
<style>.prose :global(p){font-size:17px;line-height:1.6;color:var(--muted);margin:0 0 12px}</style>

---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { getCollection } from 'astro:content';
import { marked } from 'marked';
export async function getStaticPaths() { return (await getCollection('customPages', ({ data }) => data.published || import.meta.env.DEV)).map((p) => ({ params: { slug: p.data.slug }, props: { p } })); }
const { p } = Astro.props;
---
<Base title={p.data.title} description={p.data.description}>
  {p.data.blocks.map((b) => {
    if (b.type === 'hero') return <section class={b.dark ? 'dark' : ''}><div class="wrap" style="padding-top:clamp(64px,8vw,112px);padding-bottom:clamp(64px,8vw,112px)">{b.eyebrow && <p class="eyebrow">{b.eyebrow}</p>}<h1 class="display" style="max-width:16ch">{b.heading}</h1>{b.text && <p class="lead" style="margin-top:28px">{b.text}</p>}</div></section>;
    if (b.type === 'text') return <section class="wrap" style="max-width:780px;padding-top:clamp(48px,6vw,80px);padding-bottom:clamp(48px,6vw,80px)">{b.heading && <h2 class="h2" style="font-size:clamp(30px,3.6vw,46px);margin-bottom:18px">{b.heading}</h2>}<div class="prose" set:html={marked.parse(b.body || '')} /></section>;
    if (b.type === 'two-column') return <section class="wrap grid" style="padding-top:clamp(48px,6vw,80px);padding-bottom:clamp(48px,6vw,80px)"><div>{b.eyebrow && <p class="eyebrow">{b.eyebrow}</p>}<h2 class="h2">{b.heading}</h2></div><div class="prose" set:html={marked.parse(b.body || '')} /></section>;
    if (b.type === 'bullets') return <section class="wrap" style="max-width:780px;padding-top:clamp(48px,6vw,80px);padding-bottom:clamp(48px,6vw,80px)">{b.heading && <h2 class="h2" style="font-size:clamp(30px,3.6vw,46px);margin-bottom:18px">{b.heading}</h2>}<ul style="margin:0;padding-left:20px;display:grid;gap:10px;font-size:18px;line-height:1.5">{(b.items || []).map((i) => <li>{i}</li>)}</ul></section>;
    if (b.type === 'quote') return <section class="wrap" style="max-width:900px;padding-top:clamp(48px,6vw,80px);padding-bottom:clamp(48px,6vw,80px)"><blockquote class="quote" style="font-size:clamp(22px,2.6vw,30px);padding:28px 32px">{b.text}{b.cite && <footer style="font-family:var(--sans);font-size:14px;margin-top:12px;opacity:.75">— {b.cite}</footer>}</blockquote></section>;
    if (b.type === 'image') return <section class="wrap" style="padding-top:clamp(32px,4vw,56px);padding-bottom:clamp(32px,4vw,56px)"><figure style="margin:0"><img src={b.src} alt={b.alt || ''} style="width:100%;border-radius:10px" loading="lazy" />{b.caption && <figcaption class="note" style="margin-top:10px">{b.caption}</figcaption>}</figure></section>;
    if (b.type === 'cta') return <Cta title={b.heading} body={b.text} label={b.label} href={b.href} />;
    return null;
  })}
</Base>
<style>.prose :global(p){font-size:18px;line-height:1.6;color:var(--muted);margin:0 0 16px}.prose :global(ul),.prose :global(ol){font-size:18px;line-height:1.6;color:var(--muted)}.prose :global(h3){font-family:var(--serif);font-weight:400;font-size:26px;margin:28px 0 10px}</style>

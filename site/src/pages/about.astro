---
import Base from '../layouts/Base.astro';
import c from '../content/pages/about.json';
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import { si, siRaw } from '../lib/si';
const [jen] = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const bio = await marked.parse(siRaw(jen.body));
const PH = '<div class="ph"><img src="/images/mark-color.png" alt="" aria-hidden="true" /><span>PLACEHOLDER: portrait of Jennifer Eichenberg</span></div>';
const values = c.values.map((v) => [v.name, v.text]);
const ld = { '@context': 'https://schema.org', '@type': 'Person', name: jen.data.name, jobTitle: jen.data.role, worksFor: { '@type': 'Organization', name: 'Eichenberg & Associates' }, sameAs: ['https://www.linkedin.com/in/jennifer-eichenberg'] };
---
<Base title={c.title} description={c.description} jsonLd={ld}>
  <section class="wrap grid" style="padding-top:clamp(64px,8vw,112px);padding-bottom:clamp(64px,8vw,112px)">
    <div><p class="eyebrow rise">About</p><h1 class="display word" style="font-size:clamp(44px,6.4vw,88px);animation-delay:.1s">{jen.data.name}</h1><p class="rise" style="margin:12px 0 28px;font-size:15px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--indigo);animation-delay:.25s">{jen.data.role}</p><div class="bio rise" style="animation-delay:.4s" set:html={bio} /></div>
    <div class="portrait rise" style="animation-duration:.8s;animation-delay:.3s">{jen.data.photo ? <img src={jen.data.photo} alt={`Portrait of ${jen.data.name}`} width="800" height="1000" loading="lazy" onerror={`this.outerHTML=${JSON.stringify(PH)}`} /> : <Fragment set:html={PH} />}</div>
  </section>
  <section class="dark"><div class="wrap" style="padding-top:clamp(64px,8vw,104px);padding-bottom:clamp(64px,8vw,104px)">
    <div class="grid" data-reveal style="margin-bottom:56px">
      <div><p class="eyebrow" style="margin-bottom:14px">Mission</p><p class="mv">{c.mission}</p></div>
      <div><p class="eyebrow" style="margin-bottom:14px">Vision</p><p class="mv">{c.vision}</p></div>
    </div>
    <p class="eyebrow" style="margin-bottom:24px">Values</p>
    <dl class="vals">{values.map(([n, d], i) => <div data-reveal style={`transition-delay:${i * .1}s`}><dt>{n}</dt><dd>{d}</dd></div>)}</dl>
  </div></section>
  <section class="wrap how" data-reveal style="padding-top:clamp(64px,8vw,104px);padding-bottom:clamp(64px,8vw,104px)">{c.how.map((h) => <div><p class="label">{h.label}</p><p class="how__t" set:html={si(h.text)} /></div>)}</section>
</Base>
<style>
.bio :global(p){margin:0 0 18px;font-size:19px;line-height:1.55;color:var(--muted)}
.portrait img,.portrait :global(.ph){aspect-ratio:4/5;width:100%;object-fit:cover;border-radius:10px}
.portrait :global(.ph){background:#E6E4DC;display:flex;align-items:center;justify-content:center;color:var(--faint);font-size:14px;text-align:center;padding:24px;position:relative;overflow:hidden}
.portrait :global(.ph img){position:absolute;inset:auto -10% -20% auto;width:70%;height:auto;aspect-ratio:auto;opacity:.12;border-radius:0}.portrait :global(.ph span){position:relative}
.mv{margin:0;font-family:var(--serif);font-size:clamp(24px,2.6vw,32px);line-height:1.3}
.vals{margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:32px}.vals div{border-top:1px solid rgba(255,255,255,.3);padding-top:18px}.vals dt{font-family:var(--serif);font-size:28px;margin-bottom:10px}.vals dd{margin:0;font-size:16px;line-height:1.55;color:rgba(255,255,255,.85)}
.how{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:40px}.how .label{margin:0 0 12px}.how .how__t{margin:0;font-size:17px;line-height:1.55}
</style>

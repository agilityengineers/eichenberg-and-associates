---
import Base from '../layouts/Base.astro';
import FeedList from '../components/FeedList.astro';
import { getDocs, page, setting } from '../lib/content';
import { si } from '../lib/si';
import { accent, headlineLines } from '../lib/accent';
const [site, hero, c, feeds, golive, grid] = await Promise.all([setting('site'), setting('hero'), page('home'), setting('feeds'), setting('golive'), setting('grid')]);
const services = await getDocs('services');
const quotes = await getDocs('testimonials');
const hasBg = !!(hero.backgroundImage || hero.backgroundVideo);
const tint = Math.min(1, Math.max(0, Number(hero.tint ?? 0.62)));
const tintA = hasBg ? tint : 1, tintB = hasBg ? Math.max(0, tint - 0.15) : 1;
const rotating: string[] = (hero.rotating || []).filter(Boolean);
const marquee: string[] = [...rotating, ...(hero.marqueeExtra || [])].filter(Boolean);
const card = hero.card || {};
const [line1, line2] = headlineLines(hero);
const q = String(card.quoteText || ''), qEnd = q.endsWith('?') ? '?' : '', qMain = qEnd ? q.slice(0, -1) : q;
const borders = ['var(--navy)', 'var(--indigo)', 'var(--teal)', 'var(--navy)'];
const goliveCfg = JSON.stringify({ monthsOut: golive.monthsOut, daysOut: golive.daysOut, afterGoLive: golive.afterGoLive, advice: golive.advice });
---
<Base title={c.title} description={site.description}>
  <section class="hero dark">
    {hero.backgroundVideo ? <video class="hero__bg" src={hero.backgroundVideo} poster={hero.backgroundImage || undefined} autoplay muted loop playsinline aria-hidden="true"></video>
      : hero.backgroundImage && <img class="hero__bg" src={hero.backgroundImage} alt={hero.backgroundAlt || ''} fetchpriority="high" />}
    <div class="hero__tint" aria-hidden="true" style={`background:linear-gradient(100deg,rgba(18,15,56,${tintA}) 0%,rgba(18,15,56,${tintB}) 55%,rgba(18,15,56,.35) 100%)`}></div>
    <img src="/images/mark-half-left-white.png" alt="" aria-hidden="true" class="hero__half hero__half--l" />
    <img src="/images/mark-half-right-teal.png" alt="" aria-hidden="true" class="hero__half hero__half--r" />
    <div class="wrap hero__in">
      <div>
        <p class="eyebrow rise">{hero.eyebrow}</p>
        <h1 class="hero__h"><span class="word" style="animation-delay:.1s" set:html={accent(line1)} /><br /><span class="word" style="animation-delay:.35s" set:html={accent(line2)} /></h1>
        <p class="hero__sub rise" style="animation-delay:.6s">{hero.subtitle}</p>
        {rotating.length > 0 && <p class="hero__pos" aria-live="polite" data-lines={JSON.stringify(rotating)}><span id="rotator" class="rise">{rotating[0]}</span></p>}
        <div class="hero__cta rise" style="animation-delay:.85s"><a href={hero.ctaHref} class="btn btn--teal">{hero.ctaLabel}</a><a href={hero.secondaryHref} class="btn btn--ghost">{hero.secondaryLabel}</a></div>
      </div>
      {hero.showDashboard && <div class="dash" aria-hidden="true">
        <div class="dash__card">
          <div class="dash__hd"><span>{card.title}</span><span class="dash__pill">{card.pill}</span></div>
          {(card.rows || []).map((r: { label: string; value: string }, i: number) => <div class="dash__row" style={`animation-delay:${(0.6 + i * 0.4).toFixed(1)}s`}><span>{r.label}</span><span class="dash__ok"><i></i>{r.value}</span></div>)}
        </div>
        <div class="dash__q"><p class="label" style="color:var(--navy);margin:0 0 6px">{card.quoteLabel}</p><p>{qMain}{qEnd && <span class="blink">{qEnd}</span>}</p></div>
      </div>}
    </div>
    <div class="hero__proofwrap"><ul class="wrap hero__proof">
      {(hero.proof || []).map((x: { title: string; text: string }) => <li><strong>{x.title}</strong><Fragment set:html={si(x.text)} /></li>)}
    </ul></div>
  </section>

  {marquee.length > 0 && <section class="marq" aria-label="Key messages"><div class="marq__track">{[...marquee, ...marquee].map((m, i) => <span aria-hidden={i >= marquee.length ? 'true' : undefined}>{m}<i></i></span>)}</div></section>}

  <section class="wrap section">
    <div class="grid" data-reveal>
      <div><p class="eyebrow">{c.gap.eyebrow}</p><h2 class="h2" set:html={si(c.gap.heading)} /></div>
      <div style="display:grid;gap:22px;padding-top:8px">{c.gap.paragraphs.map((t: string) => <p class="lead" style="margin:0" set:html={si(t)} />)}<p class="lead" style="margin:0;color:var(--ink);font-weight:500" set:html={si(c.gap.closing)} /></div>
    </div>
    <dl class="stats" data-reveal style="transition-delay:.1s">
      {(c.stats || []).map((x: { prefix?: string; value: number; from?: number; text: string }, i: number) => <div style={`border-color:${borders[i % 4]}`}><dt>{x.prefix}{x.from != null && x.from !== x.value ? <span data-count={x.value} data-from={x.from}>{x.value}</span> : x.value}</dt><dd>{x.text}</dd></div>)}
    </dl>
  </section>

  <section style="background:#fff;border-top:1px solid rgba(18,15,56,.08);border-bottom:1px solid rgba(18,15,56,.08)">
    <div class="wrap section">
      <div class="offers__hd" data-reveal>
        <div><p class="eyebrow">{c.offers.eyebrow}</p><h2 class="h2">{c.offers.heading}</h2></div>
        <div class="slider" data-golive={goliveCfg}>
          <div class="slider__hd"><label for="golive">{golive.label}</label><output id="golive-out" for="golive" aria-live="polite"></output></div>
          <input id="golive" type="range" min="0" max="12" step="1" value="3" />
          <div class="slider__ticks">{(golive.ticks || []).map((t: string) => <span>{t}</span>)}</div>
          <p data-advice></p>
        </div>
      </div>
      <div class="offers" data-reveal>
        {services.map((s) => <article class="offer card" data-offer={s.slug}><p class="label offer__when"><span style="color:var(--teal)">{s.data.when}</span><span class="offer__fit">{c.offers.fitLabel}</span></p><h3 class="h3">{s.data.title}</h3><p set:html={si(s.data.summary)} />{s.data.showPrice && <p class="offer__price">{s.data.price}</p>}<a href={`/services/${s.slug}`} style="font-weight:600;font-size:15px">{c.offers.learnMore}</a></article>)}
      </div>
    </div>
  </section>

  <section class="wrap section grid" data-reveal>
    <div><p class="eyebrow">{c.who.eyebrow}</p><h2 class="h2" style="margin-bottom:20px">{c.who.heading}</h2><p class="lead" style="margin:0 0 28px;max-width:48ch;font-size:18px">{c.who.lead}</p><a href="/who-we-serve" class="link">{c.who.link}</a></div>
    <dl class="dl">{c.who.facts.map((f: { label: string; text: string }) => <div><dt class="label">{f.label}</dt><dd set:html={si(f.text)} /></div>)}</dl>
  </section>

  <section class="indigo" style="position:relative;overflow:hidden"><img src="/images/mark-half-right-teal.png" alt="" aria-hidden="true" style="position:absolute;right:-4%;bottom:-20%;height:110%;width:auto;opacity:.12;pointer-events:none" /><div class="wrap section" style="position:relative">
    <div data-reveal><p class="eyebrow" style="color:var(--teal)">{c.approach.eyebrow}</p>
    <h2 class="h2" style="margin-bottom:56px;max-width:20ch">{c.approach.heading}</h2></div>
    <ol class="phases">{c.approach.phases.map((x: { num: string; name: string; text: string }, i: number) => <li data-reveal style={`transition-delay:${i * .15}s`}><span>{x.num}</span><h3>{x.name}</h3><p set:html={si(x.text)} /></li>)}</ol>
    <p style="margin:48px 0 0;font-size:15px;color:rgba(255,255,255,.75)">{c.approach.footnote}</p>
  </div></section>

  {feeds.showOnHome && <section style="background:#fff;border-top:1px solid rgba(18,15,56,.08);border-bottom:1px solid rgba(18,15,56,.08)"><div class="wrap" style="padding-top:clamp(64px,8vw,96px);padding-bottom:clamp(64px,8vw,96px)">
    <div class="feed__hd"><div><p class="eyebrow">{feeds.homeEyebrow}</p><h2 class="h2">{feeds.homeHeading}</h2></div><a href="/insights" class="link">{feeds.homeLink}</a></div>
    <FeedList limit={feeds.homeCount} />
  </div></section>}

  <section class="wrap section">
    <p class="eyebrow">{c.testimonials.eyebrow}</p>
    <div class="quotes">{quotes.map((x, i) => <figure data-reveal style={`transition-delay:${i * .15}s`}><blockquote>“{x.data.text}”</blockquote><figcaption><strong>{x.data.name}</strong>{x.data.title}</figcaption></figure>)}</div>
  </section>

  <section style="background:#fff;border-top:1px solid rgba(18,15,56,.08)"><div class="wrap grid" data-reveal style="padding-top:clamp(64px,8vw,96px);padding-bottom:clamp(64px,8vw,96px);gap:40px;align-items:center">
    <div><p class="eyebrow" set:html={si(c.partners.eyebrow)} /><h2 class="h2" style="font-size:clamp(30px,3.6vw,44px);line-height:1.1" set:html={si(c.partners.heading)} /></div>
    <div style="display:grid;gap:18px"><p class="lead" style="margin:0;font-size:17px" set:html={si(c.partners.text)} /><a href="/partners" class="link" style="justify-self:start">{c.partners.link}</a></div>
  </div></section>

  <section class="dark section">
    <div class="wrap grid" style="align-items:center">
      <div data-reveal>
        <p class="eyebrow">{c.cta.eyebrow}</p>
        <h2 class="display" style="font-size:clamp(40px,5.6vw,76px)">{c.cta.heading}</h2>
        <p class="lead" style="margin:24px 0 0;max-width:46ch;font-size:18px">{c.cta.text}</p>
        <p id="grid-result" aria-live="polite" class="grid__result" data-prompt={c.cta.prompt}>{c.cta.prompt}</p>
        <a href="/contact" class="btn btn--teal" style="margin-top:24px">{c.cta.label}</a>
      </div>
      <div class="quad" role="group" aria-label={c.cta.heading}>
        {grid.cells.map((g: { tag: string; label: string; result: string }) => <button type="button" aria-pressed="false" data-result={g.result}><span>{g.tag}</span><span>{g.label}</span></button>)}
      </div>
    </div>
  </section>
</Base>
<style>
.hero{position:relative;overflow:hidden;isolation:isolate}
.hero__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.hero__tint{position:absolute;inset:0;z-index:1;pointer-events:none}
.hero__half{z-index:1}.hero__in{z-index:2}
.hero .eyebrow{margin-bottom:28px}
.hero__h{margin:0;font-family:Poppins,var(--sans);font-weight:600;font-size:clamp(44px,6.4vw,88px);line-height:1.04;letter-spacing:-.02em;text-wrap:balance}.hero__h :global(em){font-style:normal;color:var(--teal)}
.hero__sub{margin:26px 0 0;font-size:clamp(17px,1.5vw,20px);line-height:1.55;max-width:50ch;color:#fff}
.hero__half{position:absolute;left:50%;top:-6%;height:118%;width:auto;pointer-events:none}
.hero__half--l{margin-left:-28vw;opacity:.05;animation:driftL 2.4s cubic-bezier(.2,.7,.2,1) both}.hero__half--r{margin-left:-4vw;opacity:.1;animation:driftR 2.4s cubic-bezier(.2,.7,.2,1) both}
.hero__in{position:relative;padding-top:clamp(64px,8vw,112px);padding-bottom:clamp(56px,7vw,96px);display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:48px;align-items:center}
.hero__pos{margin:18px 0 0;font-family:var(--serif);font-style:italic;font-size:clamp(18px,1.8vw,22px);line-height:1.35;max-width:44ch;min-height:2.7em;color:rgba(255,255,255,.85)}#rotator{display:inline-block}
.hero__cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px}.hero__cta .btn{white-space:nowrap}
.dash{position:relative;max-width:460px;width:100%;justify-self:center;align-self:end;margin-top:clamp(120px,22vw,300px);padding:0 6% 34px;animation:floatY 7s 3s ease-in-out infinite}
.dash__card{background:#fff;color:var(--navy);border-radius:10px;padding:22px 22px 18px;box-shadow:0 30px 60px rgba(0,0,0,.35)}
.dash__hd{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;font-size:12px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--navy)}
.dash__pill{font-size:12px;letter-spacing:0;text-transform:none;color:#fff;background:var(--teal);padding:4px 10px;border-radius:99px}
.dash__row{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-top:1px solid rgba(18,15,56,.08);font-size:15px;font-weight:500;animation:rowIn .5s ease-out both}
.dash__ok{display:flex;align-items:center;gap:8px;font-size:14px;color:var(--navy);font-weight:600}.dash__ok i{width:10px;height:10px;border-radius:50%;background:var(--teal)}
.dash__q{position:absolute;left:0;right:0;bottom:0;background:var(--teal);color:var(--navy);border-radius:10px;padding:22px 24px;box-shadow:0 24px 50px rgba(0,0,0,.35);animation:dropIn .9s 2.7s cubic-bezier(.2,.8,.2,1) both}
.dash__q p:last-child{margin:0;font-family:var(--serif);font-size:clamp(20px,2vw,24px);line-height:1.25}.blink{display:inline-block;animation:blink 1.2s 3.6s ease-in-out infinite}
.marq{background:var(--teal);color:var(--navy);overflow:hidden;padding:18px 0;border-bottom:1px solid rgba(18,15,56,.15)}
.marq__track{display:flex;width:max-content;animation:marquee 60s linear infinite}.marq:hover .marq__track{animation-play-state:paused}
.marq span{font-family:var(--serif);font-size:22px;white-space:nowrap;padding:0 28px;display:inline-flex;align-items:center;gap:28px}.marq i{width:6px;height:6px;border-radius:50%;background:var(--navy);opacity:.6}
.stats{margin:clamp(56px,7vw,88px) 0 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:2px}.stats div{padding:24px 24px 24px 0;border-top:2px solid}.stats dt{font-family:var(--serif);font-size:clamp(44px,5vw,64px);line-height:1;letter-spacing:-.02em}.stats dd{margin:10px 0 0;font-size:15px;color:var(--muted)}
.slider{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:22px 24px}
.slider__hd{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap}.slider__hd label{font-size:14px;font-weight:600}.slider__hd output{font-family:var(--serif);font-size:22px;color:var(--indigo)}
.slider input{width:100%;margin:14px 0 8px;cursor:pointer}.slider__ticks{display:flex;justify-content:space-between;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--faint);font-weight:600}.slider p{margin:14px 0 0;font-size:15px;line-height:1.45;min-height:2.9em}
.offer__when{display:flex;justify-content:space-between;gap:8px}.offer__fit{color:var(--indigo);opacity:0;transition:opacity .4s}
.offer.fit{background:var(--paper);outline-color:var(--teal);box-shadow:0 18px 36px rgba(20,182,161,.18)}.offer.fit .offer__fit{opacity:1}
.grid__result{margin:24px 0 0;font-family:var(--serif);font-size:clamp(22px,2.4vw,30px);line-height:1.25;color:var(--teal);min-height:2.5em}
.quad{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px;max-width:520px;width:100%;justify-self:center;min-width:0}
.quad button{aspect-ratio:1.15;min-width:0;text-align:left;padding:20px;border-radius:10px;border:1px solid rgba(255,255,255,.25);background:rgba(255,255,255,.06);color:#fff;cursor:pointer;display:flex;flex-direction:column;justify-content:space-between;font:inherit;transition:background .35s,transform .35s cubic-bezier(.2,.7,.2,1),border-color .35s}
.quad button:hover{transform:translateY(-4px)}.quad button span:first-child{font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;opacity:.7}.quad button span:last-child{font-family:var(--serif);font-size:clamp(18px,2vw,24px);line-height:1.15}
.quad button[aria-pressed="true"]{background:var(--teal);color:var(--navy);border-color:var(--teal);transform:scale(1.03)}
.hero__proofwrap{position:relative;z-index:2;margin-top:36px;border-top:1px solid rgba(255,255,255,.12);background:rgba(18,15,56,.55);backdrop-filter:blur(6px)}
.hero__proof{list-style:none;margin:0 auto;padding-top:22px;padding-bottom:22px;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px 32px;font-size:14px;line-height:1.45;color:rgba(255,255,255,.75)}
.hero__proof strong{display:block;color:#fff;font-weight:600}
.offers__hd{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:40px;align-items:end;margin-bottom:40px}
.feed__hd{display:flex;justify-content:space-between;align-items:end;gap:24px;flex-wrap:wrap;margin-bottom:32px}
.offers{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(290px,1fr))}
.offer{background:#fff;outline:1px solid rgba(18,15,56,.12);outline-offset:-1px;padding:34px 30px 30px;transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s,background .4s,outline-color .4s;display:flex;flex-direction:column;gap:16px;min-height:360px}.offer .h3{letter-spacing:-.01em}.offer__when{letter-spacing:.24em}.offer p{margin:0;font-size:16px;line-height:1.55;color:var(--muted);flex:1}.offer .label{flex:0}.offer__price{flex:0!important;font-weight:600;color:var(--ink)!important;font-size:14px}
.phases{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:40px 32px}
.phases li{border-top:1px solid rgba(255,255,255,.35);padding-top:22px}.phases span{display:block;font-family:var(--serif);font-size:15px;color:var(--teal);margin-bottom:12px}.phases h3{margin:0 0 10px;font-family:var(--serif);font-weight:400;font-size:34px;line-height:1.05}.phases p{margin:0;color:rgba(255,255,255,.85)}
.quotes{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:32px;margin-top:32px}
.quotes figure{margin:0;display:flex;flex-direction:column;gap:18px;padding-left:24px;border-left:2px solid var(--teal)}
.quotes blockquote{margin:0;font-family:var(--serif);font-size:22px;line-height:1.35}.quotes figcaption{font-size:14px;color:var(--muted)}.quotes strong{display:block;color:var(--ink)}
</style>
<script>
  import '../scripts/golive';
  // Rotating hero line
  let rot = document.getElementById('rotator'); let i = 0;
  const lines: string[] = JSON.parse((rot?.parentElement as HTMLElement | null)?.dataset.lines || '[]');
  if (rot && lines.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(() => { i = (i + 1) % lines.length; const s = rot!.cloneNode() as HTMLElement; s.textContent = lines[i]; rot!.replaceWith(s); rot = s; }, 4200);

  // Who can lead it / do it grid
  const res = document.getElementById('grid-result'); const btns = document.querySelectorAll<HTMLButtonElement>('.quad button');
  btns.forEach((b) => b.addEventListener('click', () => { const on = b.getAttribute('aria-pressed') === 'true'; btns.forEach((x) => x.setAttribute('aria-pressed', 'false')); if (!on) { b.setAttribute('aria-pressed', 'true'); res!.textContent = b.dataset.result!; } else res!.textContent = res!.dataset.prompt || ''; }));
</script>

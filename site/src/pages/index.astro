---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import site from '../content/settings/site.json';
import hero from '../content/settings/hero.json';
import c from '../content/pages/home.json';
import feeds from '../content/settings/feeds.json';
import FeedList from '../components/FeedList.astro';
const hasBg = !!(hero.backgroundImage || hero.backgroundVideo);
const tintA = hasBg ? hero.tint : 1, tintB = hasBg ? Math.max(0, hero.tint - 0.15) : 1;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const quotes = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
const marquee = ['“Your Systems Integrator (SI) knows the system. We know your people.”', 'Training completion tells you who clicked through. It doesn’t tell you who can do the job on day one.', 'Your Systems Integrator (SI) will get the system live. Who’s making sure your people can run the operation on day one?', 'Your programs grade their own readiness. An independent assessment gives you one standard across every go-live.', 'Integration plans cover systems and contracts. Synergies depend on whether two workforces actually work as one.', 'Trained isn’t ready.', 'Every dashboard is green. Her gut says otherwise.', 'Day 1 is fixed. Two workforces aren’t one yet.', 'When adoption stalls, the client blames the implementation.', 'The Systems Integrator (SI) brings system expertise. We bring people expertise.'];
const phases = c.approach.phases.map((p) => [p.num, p.name, p.text]);
---
<Base title={c.title} description={site.description}>
  <section class="hero dark">
    {hero.backgroundVideo ? <video class="hero__bg" src={hero.backgroundVideo} poster={hero.backgroundImage || undefined} autoplay muted loop playsinline aria-hidden="true"></video>
      : hero.backgroundImage && <img class="hero__bg" src={hero.backgroundImage} alt={hero.backgroundAlt} fetchpriority="high" />}
    <div class="hero__tint" aria-hidden="true" style={`background:linear-gradient(100deg,rgba(18,15,56,${tintA}) 0%,rgba(18,15,56,${tintB}) 55%,rgba(18,15,56,.35) 100%)`}></div>
    <img src="/images/mark-half-left-white.png" alt="" aria-hidden="true" class="hero__half hero__half--l" />
    <img src="/images/mark-half-right-teal.png" alt="" aria-hidden="true" class="hero__half hero__half--r" />
    <div class="wrap hero__in">
      <div>
        <p class="eyebrow rise">{hero.eyebrow}</p>
        <h1 class="hero__h"><span class="word" style="animation-delay:.1s"><em>{hero.headlineAccent1}</em> {hero.headlineRest1}</span><br /><span class="word" style="animation-delay:.35s"><em>{hero.headlineAccent2}</em> {hero.headlineRest2}</span></h1>
        <p class="hero__sub rise" style="animation-delay:.6s">{hero.subtitle}</p>
        <p class="hero__pos" aria-live="polite"><span id="rotator" class="rise">“{site.positioning}”</span></p>
        <div class="hero__cta rise" style="animation-delay:.85s"><a href={hero.ctaHref} class="btn btn--teal">{hero.ctaLabel}</a><a href={hero.secondaryHref} class="btn btn--ghost">{hero.secondaryLabel}</a></div>
      </div>
      {hero.showDashboard && <div class="dash" aria-hidden="true">
        <div class="dash__card">
          <div class="dash__hd"><span>Go-live readiness</span><span class="dash__pill">All green</span></div>
          {[['Training completion', '98%', '.6s'], ['UAT sign-off', 'Passed', '1s'], ['Cutover plan', 'Approved', '1.4s'], ['Program status', 'Green', '1.8s']].map(([l, v, d]) => <div class="dash__row" style={`animation-delay:${d},2.9s`}><span>{l}</span><span class="dash__ok"><i></i>{v}</span></div>)}
        </div>
        <div class="dash__q"><p class="label" style="color:var(--navy);margin:0 0 6px">Every dashboard is green. Her gut says otherwise.</p><p>Who can do the job on day one<span class="blink">?</span></p></div>
      </div>}
    </div>
    <ul class="wrap hero__proof">
      <li><strong>System-agnostic</strong>Readiness across ERP, PM, and HR</li>
      <li><strong>Senior lead, flexible bench</strong>A senior lead, with contract associates for production work</li>
      <li><strong>Ready on day one</strong>A built OCM toolkit saves roughly 150 build hours on an ERP project</li>
      <li><strong>WBENC certified</strong>Helps clients and Systems Integrator (<abbr title="Systems Integrator" style="text-decoration:underline dotted;text-underline-offset:3px;cursor:help">SI</abbr>) partners meet supplier diversity goals</li>
    </ul>
  </section>

  <section class="marq" aria-label="Key messages"><div class="marq__track">{[...marquee, ...marquee].map((m) => <span>{m}<i></i></span>)}</div></section>

  <section class="wrap section grid" data-reveal>
    <div><p class="eyebrow">{c.gap.eyebrow}</p><h2 class="h2">{c.gap.heading}</h2></div>
    <div style="display:grid;gap:22px;padding-top:8px">{c.gap.paragraphs.map((t) => <p class="lead" style="margin:0">{t}</p>)}<p class="lead" style="margin:0;color:var(--ink);font-weight:500">{c.gap.closing}</p></div>
  </section>
  <section class="wrap" style="padding-bottom:clamp(72px,9vw,120px)"><dl class="stats" data-reveal>
    <div style="border-color:var(--navy)"><dt><span data-count="2007" data-from="1990" data-ms="1600">2007</span></dt><dd>Every engagement since, inside ERP, PM and HR programs</dd></div>
    <div style="border-color:var(--indigo)"><dt>~<span data-count="150">150</span></dt><dd>Build hours a built OCM toolkit saves on an ERP project</dd></div>
    <div style="border-color:var(--teal)"><dt>≤<span data-count="90" data-ms="1200">90</span></dt><dd>Days before go-live for a Readiness Assessment</dd></div>
    <div style="border-color:var(--navy)"><dt>3</dt><dd>Phases, fixed fee by phase: Prepare, Act, Sustain</dd></div>
  </dl></section>

  <section style="background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
    <div class="wrap section">
      <div class="offers__hd" data-reveal>
        <div><p class="eyebrow">What we offer</p><h2 class="h2">Three offers around one go-live</h2></div>
        <div class="slider">
          <div class="slider__hd"><label for="golive">Where is your go-live?</label><output id="golive-out" for="golive" aria-live="polite">9 months out</output></div>
          <input id="golive" type="range" min="0" max="12" step="1" value="9" />
          <div class="slider__ticks"><span>Go-live + 90 days</span><span>≤ 90 days</span><span>Kickoff · 12 months</span></div>
          <p id="golive-advice"></p>
        </div>
      </div>
      <div class="offers" data-reveal>
        {services.map((s) => <article class="cell offer card" data-offer={s.slug}><p class="label offer__when"><span style="color:var(--teal)">{s.data.when}</span><span class="offer__fit">Fits now</span></p><h3 class="h3">{s.data.title}</h3><p>{s.data.summary}</p>{s.data.showPrice && <p class="offer__price">{s.data.price}</p>}<a href={`/services/${s.slug}`} style="font-weight:600;font-size:15px">Learn more →</a></article>)}
      </div>
    </div>
  </section>

  <section class="wrap section grid" data-reveal>
    <div><p class="eyebrow">{c.who.eyebrow}</p><h2 class="h2" style="margin-bottom:20px">{c.who.heading}</h2><p class="lead" style="margin:0 0 28px;max-width:48ch">{c.who.lead}</p><a href="/who-we-serve" class="link">{c.who.link}</a></div>
    <dl class="dl">{c.who.facts.map((f) => <div><dt class="label">{f.label}</dt><dd>{f.text}</dd></div>)}</dl>
  </section>

  <section class="indigo" style="position:relative;overflow:hidden"><img src="/images/mark-half-right-teal.png" alt="" aria-hidden="true" style="position:absolute;right:-4%;bottom:-20%;height:110%;width:auto;opacity:.12;pointer-events:none" /><div class="wrap section" style="position:relative">
    <p class="eyebrow" style="color:var(--teal)">{c.approach.eyebrow}</p>
    <h2 class="h2" style="margin-bottom:56px;max-width:20ch">{c.approach.heading}</h2>
    <ol class="phases">{phases.map(([n, t, d], i) => <li data-reveal style={`transition-delay:${i * .15}s`}><span>{n}</span><h3>{t}</h3><p>{d}</p></li>)}</ol>
    <p style="margin:48px 0 0;font-size:15px;color:rgba(255,255,255,.75)">{c.approach.footnote}</p>
  </div></section>

  {feeds.showOnHome && <section style="background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)"><div class="wrap" style="padding-top:clamp(64px,8vw,96px);padding-bottom:clamp(64px,8vw,96px)">
    <div class="offers__hd" style="margin-bottom:32px"><div><p class="eyebrow">{feeds.homeEyebrow}</p><h2 class="h2">{feeds.homeHeading}</h2></div><a href="/insights" class="link">All insights →</a></div>
    <FeedList limit={feeds.homeCount} />
  </div></section>}

  <section class="wrap section">
    <p class="eyebrow">{c.testimonials.eyebrow}</p>
    <div class="quotes">{quotes.map((q, i) => <figure data-reveal style={`transition-delay:${i * .15}s`}><blockquote>“{q.data.text}”</blockquote><figcaption><strong>{q.data.name}</strong>{q.data.title}</figcaption></figure>)}</div>
  </section>

  <section style="background:#fff;border-top:1px solid var(--line)"><div class="wrap grid" style="padding-top:clamp(64px,8vw,96px);padding-bottom:clamp(64px,8vw,96px);align-items:center">
    <div><p class="eyebrow">{c.partners.eyebrow}</p><h2 class="h2" style="font-size:clamp(30px,3.6vw,44px)">{c.partners.heading}</h2></div>
    <div style="display:grid;gap:18px"><p class="lead" style="margin:0;font-size:17px">{c.partners.text}</p><a href="/partners" class="link" style="justify-self:start">{c.partners.link}</a></div>
  </div></section>

  <section class="dark section">
    <div class="wrap grid" style="align-items:center">
      <div data-reveal>
        <p class="eyebrow">{c.cta.eyebrow}</p>
        <h2 class="display" style="font-size:clamp(40px,5.6vw,76px)">{c.cta.heading}</h2>
        <p class="lead" style="margin:24px 0 0;max-width:46ch">{c.cta.text}</p>
        <p id="grid-result" aria-live="polite" class="grid__result">{c.cta.prompt}</p>
        <a href="/contact" class="btn btn--teal" style="margin-top:24px">{c.cta.label}</a>
      </div>
      <div class="quad" role="group" aria-label="Who can lead it, who can do it grid">
        {[['Can’t lead it · Can’t do it', 'We need someone to lead the change and do the work.', 'Continue to Discovery.'], ['Can’t lead it · Can do it', 'We have hands, but no one to lead it.', 'Continue to Discovery.'], ['Can lead it · Can’t do it', 'We have a leader, but no capacity to do the work.', 'Continue to Discovery.'], ['Can lead it · Can do it', 'We can lead it and do it ourselves.', 'Stay in touch, ask for a referral.']].map(([t, l, r]) => <button type="button" aria-pressed="false" data-result={r}><span>{t}</span><span>{l}</span></button>)}
      </div>
    </div>
  </section>
</Base>
<style>
.hero{position:relative;overflow:hidden;isolation:isolate}
.hero__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.hero__tint{position:absolute;inset:0;z-index:1;pointer-events:none}
.hero__half{z-index:1}.hero__in{z-index:2}
.hero__h{margin:0;font-family:Poppins,var(--sans);font-weight:600;font-size:clamp(44px,6.4vw,88px);line-height:1.04;letter-spacing:-.02em;text-wrap:balance}.hero__h em{font-style:normal;color:var(--teal)}
.hero__sub{margin:26px 0 0;font-size:clamp(17px,1.5vw,20px);line-height:1.55;max-width:50ch;color:#fff}
.hero__half{position:absolute;left:50%;top:-6%;height:118%;width:auto;pointer-events:none}
.hero__half--l{margin-left:-28vw;opacity:.07;animation:driftL 2.4s cubic-bezier(.2,.7,.2,1) both}.hero__half--r{margin-left:-4vw;opacity:.16;animation:driftR 2.4s cubic-bezier(.2,.7,.2,1) both}
.hero__in{position:relative;padding-top:clamp(64px,8vw,112px);padding-bottom:clamp(56px,7vw,96px);display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:48px;align-items:center}
.hero__pos{margin:18px 0 0;font-family:var(--serif);font-style:italic;font-size:clamp(18px,1.8vw,22px);line-height:1.35;max-width:44ch;min-height:2.7em;color:rgba(255,255,255,.85)}#rotator{display:inline-block}
.hero__cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:36px}.hero__cta .btn{white-space:nowrap}
.dash{position:relative;max-width:460px;width:100%;justify-self:center;align-self:end;margin-top:clamp(120px,22vw,300px);padding:0 6% 34px;animation:floatY 7s 3s ease-in-out infinite}
.dash__card{background:#fff;color:var(--navy);border-radius:10px;padding:22px 22px 18px;box-shadow:0 30px 60px rgba(0,0,0,.35)}
.dash__hd{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;font-size:12px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--navy)}
.dash__pill{font-size:12px;letter-spacing:0;text-transform:none;color:#fff;background:var(--teal);padding:4px 10px;border-radius:99px}
.dash__row{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-top:1px solid rgba(18,15,56,.08);font-size:15px;font-weight:500;animation:rowIn .5s ease-out both}
.dash__ok{display:flex;align-items:center;gap:8px;font-size:14px;color:var(--navy);font-weight:600}.dash__ok::before{content:"";width:10px;height:10px;border-radius:50%;background:var(--teal)}.dash__ok i{width:10px;height:10px;border-radius:50%;background:#14B6A1}
.dash__q{position:absolute;left:0;right:0;bottom:0;background:var(--teal);color:var(--navy);border-radius:10px;padding:22px 24px;box-shadow:0 24px 50px rgba(0,0,0,.35);animation:dropIn .9s 2.7s cubic-bezier(.2,.8,.2,1) both}
.dash__q p:last-child{margin:0;font-family:var(--serif);font-size:clamp(20px,2vw,24px);line-height:1.25}.blink{display:inline-block;animation:blink 1.2s 3.6s ease-in-out infinite}
.marq{background:var(--teal);color:var(--navy);overflow:hidden;padding:18px 0;border-bottom:1px solid rgba(18,15,56,.15)}
.marq__track{display:flex;width:max-content;animation:marquee 60s linear infinite}.marq:hover .marq__track{animation-play-state:paused}
.marq span{font-family:var(--serif);font-size:22px;white-space:nowrap;padding:0 28px;display:inline-flex;align-items:center;gap:28px}.marq i{width:6px;height:6px;border-radius:50%;background:var(--navy);opacity:.6}
.stats{margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:2px}.stats div{padding:24px 24px 24px 0;border-top:2px solid}.stats dt{font-family:var(--serif);font-size:clamp(44px,5vw,64px);line-height:1;letter-spacing:-.02em}.stats dd{margin:10px 0 0;font-size:15px;color:var(--muted)}
.slider{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:22px 24px}
.slider__hd{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap}.slider__hd label{font-size:14px;font-weight:600}.slider__hd output{font-family:var(--serif);font-size:22px;color:var(--indigo)}
.slider input{width:100%;margin:14px 0 8px;cursor:pointer}.slider__ticks{display:flex;justify-content:space-between;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--faint);font-weight:600}.slider p{margin:14px 0 0;font-size:15px;line-height:1.45;min-height:2.9em}
.offer__when{display:flex;justify-content:space-between;gap:8px}.offer__fit{color:var(--indigo);opacity:0;transition:opacity .4s}
.offer.fit{background:var(--paper);outline-color:var(--teal);box-shadow:0 18px 36px rgba(20,182,161,.18)}.offer.fit .offer__fit{opacity:1}
.grid__result{margin:24px 0 0;font-family:var(--serif);font-size:clamp(22px,2.4vw,30px);line-height:1.25;color:var(--teal);min-height:2.5em}
.quad{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px;max-width:520px;width:100%;justify-self:center;min-width:0}
.quad button{aspect-ratio:1.15;min-width:0;text-align:left;padding:20px;border-radius:10px;border:1px solid rgba(255,255,255,.25);background:rgba(255,255,255,.06);color:#fff;cursor:pointer;display:flex;flex-direction:column;justify-content:space-between;font:inherit;transition:background .35s,transform .35s cubic-bezier(.2,.7,.2,1),border-color .35s}
.quad button:hover{transform:translateY(-4px)}.quad button span:first-child{font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;opacity:.7}.quad button span:last-child{font-family:var(--serif);font-size:clamp(18px,2vw,24px);line-height:1.15}
.quad button[aria-pressed="true"]{background:var(--teal);color:var(--navy);border-color:var(--teal);transform:scale(1.03)}
.hero__proof{position:relative;z-index:2;list-style:none;margin:36px auto 0;padding-top:22px;padding-bottom:22px;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px 32px;border-top:1px solid rgba(255,255,255,.12);font-size:14px;color:rgba(255,255,255,.75)}
.hero__proof strong{display:block;color:#fff;font-weight:600}
.offers__hd{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:40px;align-items:end;margin-bottom:40px}
.offers{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(290px,1fr))}
.offer{outline:1px solid rgba(18,15,56,.12);outline-offset:-1px;padding:34px 30px 30px;transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s,background .4s,outline-color .4s;display:flex;flex-direction:column;gap:16px;min-height:360px}.offer:hover{background:var(--paper)}.offer p{margin:0;color:var(--muted);flex:1}.offer .label{flex:0}.offer__price{flex:0!important;font-weight:600;color:var(--ink)!important;font-size:14px}
.phases{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:40px 32px}
.phases li{border-top:1px solid rgba(255,255,255,.35);padding-top:22px}.phases span{display:block;font-family:var(--serif);font-size:15px;color:var(--teal);margin-bottom:12px}.phases h3{margin:0 0 10px;font-family:var(--serif);font-weight:400;font-size:34px;line-height:1.05}.phases p{margin:0;color:rgba(255,255,255,.85)}
.quotes{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:32px;margin-top:32px}
.quotes figure{margin:0;display:flex;flex-direction:column;gap:18px;padding-left:24px;border-left:2px solid var(--teal)}
.quotes blockquote{margin:0;font-family:var(--serif);font-size:22px;line-height:1.35}.quotes figcaption{font-size:14px;color:var(--muted)}.quotes strong{display:block;color:var(--ink)}
</style>
<script>
  // Rotating hero line
  const lines = ['“Your SI knows the system. We know your people.”', 'Training completion tells you who clicked through. It doesn’t tell you who can do the job on day one.', 'Your SI will get the system live. Who’s making sure your people can run the operation on day one?', 'Your programs grade their own readiness. An independent assessment gives you one standard across every go-live.', 'Integration plans cover systems and contracts. Synergies depend on whether two workforces actually work as one.'];
  let rot = document.getElementById('rotator'); let i = 0;
  if (rot && !matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(() => { i = (i + 1) % lines.length; const s = rot!.cloneNode() as HTMLElement; s.textContent = lines[i]; rot!.replaceWith(s); rot = s; }, 4200);

  // Go-live slider
  const r = document.getElementById('golive') as HTMLInputElement | null, out = document.getElementById('golive-out'), adv = document.getElementById('golive-advice');
  const advice: Record<string, string> = { kickoff: 'Program funded, SI selected, date set. Start with Project Role Readiness at kickoff, inside a phased OCM Leadership engagement: Prepare first.', delivery: 'You’re in delivery. OCM Leadership runs the Act phase, with contract associates for production work and a Readiness Assessment coming at 90 days or less.', assess: '90 days or less before go-live: a 3–4 week Readiness Assessment. Know, with evidence, whether people can perform. It leads into gap-closure work.', after: 'Go-live plus 90 days: the Sustain check-in. A read on adoption, and planning for the next initiative.' };
  const fit: Record<string, string[]> = { kickoff: ['project-role-readiness', 'ocm-leadership'], delivery: ['ocm-leadership'], assess: ['readiness-assessment'], after: [] };
  const update = () => { if (!r) return; const m = +r.value; const stage = m >= 7 ? 'kickoff' : m >= 4 ? 'delivery' : m >= 1 ? 'assess' : 'after';
    out!.textContent = m === 0 ? 'Go-live + 90 days' : m <= 3 ? m * 30 + ' days out' : m + ' months out'; adv!.textContent = advice[stage];
    document.querySelectorAll<HTMLElement>('[data-offer]').forEach((el) => el.classList.toggle('fit', fit[stage].includes(el.dataset.offer!))); };
  r?.addEventListener('input', update); update();

  // Who can lead it / do it grid
  const res = document.getElementById('grid-result'); const btns = document.querySelectorAll<HTMLButtonElement>('.quad button');
  btns.forEach((b) => b.addEventListener('click', () => { const on = b.getAttribute('aria-pressed') === 'true'; btns.forEach((x) => x.setAttribute('aria-pressed', 'false')); if (!on) { b.setAttribute('aria-pressed', 'true'); res!.textContent = b.dataset.result!; } else res!.textContent = 'Pick the quadrant that sounds like you.'; }));
</script>

---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { getDocs, md } from '../../lib/content';
import { siRaw } from '../../lib/si';
const p = (await getDocs('insights')).find((d) => d.slug === Astro.params.slug && (!d.data.draft || !!Astro.locals.user));
if (!p) return new Response(null, { status: 404 });
const date = new Date(p.data.date);
const ld = { '@context': 'https://schema.org', '@type': 'Article', headline: p.data.title, description: p.data.description, datePublished: date.toISOString(), author: { '@type': 'Person', name: p.data.author } };
---
<Base title={p.data.title} description={p.data.description} type="article" jsonLd={ld} noindex={!!p.data.draft}>
  <article class="wrap" style="padding-top:clamp(64px,8vw,112px);padding-bottom:clamp(64px,8vw,104px);max-width:780px">
    <p class="eyebrow eyebrow--teal">{p.data.tag}</p>
    <h1 class="display" style="font-size:clamp(36px,5vw,64px)">{p.data.title}</h1>
    <p class="note" style="margin:16px 0 40px">{p.data.author} · <time datetime={date.toISOString()}>{date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time></p>
    <div class="prose" set:html={md(siRaw(p.body))} />
  </article>
  <Cta />
</Base>
<style>.prose :global(p){font-size:19px;line-height:1.6;color:var(--muted);margin:0 0 20px}.prose :global(h2){font-family:var(--serif);font-weight:400;font-size:32px;margin:40px 0 12px}.prose :global(ul),.prose :global(ol){font-size:19px;line-height:1.6;color:var(--muted)}</style>

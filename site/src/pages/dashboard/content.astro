---
import Dashboard from '../../layouts/Dashboard.astro';
export const prerender = false;
const sb = (Astro.locals as any).sb;
const { data: items } = await sb.from('content_items').select('*').order('month'); const S = ['Drafting', 'Published', 'Cut & scheduled'], C = ['pill--grey', 'pill--indigo', 'pill--teal'];
---
<Dashboard title="Monthly post → LinkedIn cuts → newsletter" eyebrow="Content engine" active="content">


<p class="note" style="margin:0 0 12px">One blog post a month, cut into 6–8 LinkedIn posts, plus the email newsletter. Two lead magnets build the list.</p>
<section style="display:grid;gap:12px">{(items || []).map((c) => <article class="panel panel--pad" style="display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:18px;align-items:center"><div><p class="label" style="margin:0 0 6px">{new Date(c.month).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</p><h2 class="h3" style="font-size:22px;margin-bottom:6px">{c.title}</h2><button class={'pill ' + C[c.status]} data-action="patch" data-table="content_items" data-id={c.id} data-field="status" data-value={(c.status + 1) % 3}>{S[c.status]}</button></div>
  <div><p class="note" style="margin:0 0 8px">LinkedIn cuts · {c.cuts_done} of {c.cuts} posted <button class="note" data-action="patch" data-table="content_items" data-id={c.id} data-field="cuts_done" data-value={Math.min(c.cuts, c.cuts_done + 1)} style="border:0;background:none;color:var(--indigo);cursor:pointer;font-weight:600">+1</button></p><div style="display:flex;gap:4px;flex-wrap:wrap">{Array.from({ length: c.cuts }, (_, k) => <span style={`width:26px;height:26px;border-radius:6px;display:inline-block;background:${k < c.cuts_done ? 'var(--teal)' : 'rgba(18,15,56,.1)'}`}></span>)}</div><p class="note" style="margin:10px 0 0">Newsletter: {c.newsletter || '—'}</p></div></article>)}
<form class="panel panel--pad" data-save="content_items" data-method="POST" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center"><input name="month" type="month" required style="font:inherit;padding:8px 10px;border:1px solid rgba(18,15,56,.15);border-radius:6px" /><input name="title" placeholder="Post title" required style="font:inherit;padding:8px 10px;border:1px solid rgba(18,15,56,.15);border-radius:6px;flex:1;min-width:220px" /><input name="cuts" type="number" value="6" min="1" max="12" style="font:inherit;padding:8px 10px;border:1px solid rgba(18,15,56,.15);border-radius:6px;width:80px" aria-label="LinkedIn cuts" /><button class="btn-sm" type="submit">+ Add month</button><span role="status" class="note"></span></form></section>
</Dashboard>

---
import Dashboard from '../../layouts/Dashboard.astro';
export const prerender = false;
const sb = (Astro.locals as any).sb;
import { STAGES, STAGE_Q } from '../../lib/personas.js';
const { data: deals } = await sb.from('deals').select('*, partners(firm)').order('next_due');
const GRID: Record<string, string> = { nn: 'Can’t lead · Can’t do', nd: 'Can’t lead · Can do', ln: 'Can lead · Can’t do', ld: 'Can lead · Can do' };
const cap = (fee: number) => fee ? Math.round(fee * 0.1 / 200) : 15;  // 10% of fee at $200/h
---
<Dashboard title="Five stages, from first call to repeat work" eyebrow="Sales process" active="pipeline">


<p class="note" style="margin:0 0 16px">Spend up to 10% of the proposed fee to win it. Assessment: 10–15 hours. Anchor: about 100 hours, over months. Drag a card between stages, or use the arrows.</p>
<section class="cols">{STAGES.map((s, i) => <div class="col" data-stage={s}><h2>{s} <small>{(deals || []).filter((d) => d.stage === s).length}</small></h2><p class="q">{STAGE_Q[s]}</p>
  {(deals || []).filter((d) => d.stage === s).map((d) => <article class="deal" draggable="true" data-deal={d.id} style={d.offer && /assess/i.test(d.offer) ? 'border-left-color:var(--teal)' : ''}><div style="display:flex;justify-content:space-between;gap:8px"><strong style="font-size:14px">{d.company}</strong><span style="font-weight:600">{d.fee_estimate ? '$' + Math.round(d.fee_estimate / 1000) + 'K' : '—'}</span></div><span class="note">{d.contact}</span>
    <div style="display:flex;gap:6px;flex-wrap:wrap">{d.offer && <span class="pill pill--teal" style="font-size:11px">{d.offer}</span>}{d.source && <span class="pill pill--indigo" style="font-size:11px">{d.source}</span>}</div>
    <dl><dt>Go-live</dt><dd>{d.go_live || '—'}</dd><dt>Partner</dt><dd>{d.partners?.firm || '—'}</dd><dt>Grid</dt><dd>{GRID[d.grid] || '—'}</dd><dt>BD hours</dt><dd style={Number(d.bd_hours) > cap(d.fee_estimate) ? 'color:#B3261E' : ''}>{d.bd_hours} of {cap(d.fee_estimate)}h budget</dd></dl>
    <p style="margin:0;padding-top:8px;border-top:1px solid rgba(18,15,56,.08)"><strong>Next:</strong> {d.next_step || '—'} <span class="note">· {d.next_due || ''}</span></p>
    <div class="acts">{i > 0 && <button data-action="patch" data-table="deals" data-id={d.id} data-field="stage" data-value={STAGES[i - 1]}>←</button>}{i < 4 && <button class="adv" data-action="patch" data-table="deals" data-id={d.id} data-field="stage" data-value={STAGES[i + 1]}>Advance →</button>}<a href={'/dashboard/deal?id=' + d.id} class="note" style="align-self:center">Edit</a></div></article>)}
</div>)}</section>
</Dashboard>
<style>.deal[draggable]{cursor:grab}.deal.dragging{opacity:.45}.col.over{background:rgba(20,182,161,.12);outline:1px dashed var(--teal)}</style>
<script>
  let dragId: string | null = null;
  document.querySelectorAll<HTMLElement>('.deal[draggable]').forEach((c) => { c.addEventListener('dragstart', (e) => { dragId = c.dataset.deal!; e.dataTransfer!.setData('text/plain', dragId); e.dataTransfer!.effectAllowed = 'move'; c.classList.add('dragging'); }); c.addEventListener('dragend', () => { c.classList.remove('dragging'); document.querySelectorAll('.col.over').forEach((x) => x.classList.remove('over')); }); });
  document.querySelectorAll<HTMLElement>('.col[data-stage]').forEach((col) => {
    col.addEventListener('dragover', (e) => { e.preventDefault(); e.dataTransfer!.dropEffect = 'move'; col.classList.add('over'); });
    col.addEventListener('dragleave', (e) => { if (!col.contains(e.relatedTarget as Node)) col.classList.remove('over'); });
    col.addEventListener('drop', async (e) => { e.preventDefault(); col.classList.remove('over'); const id = e.dataTransfer!.getData('text/plain') || dragId; if (!id) return; const card = document.querySelector(`[data-deal="${id}"]`); if (card) col.appendChild(card); await (window as any).api('deals', 'PATCH', { id, stage: col.dataset.stage }); location.reload(); });
  });
</script>

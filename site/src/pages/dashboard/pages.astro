---
import Dashboard from '../../layouts/Dashboard.astro';
import Editor from '../../components/cms/Editor.astro';
import { LANDING_FIELDS } from '../../lib/cms-schema';
import { q } from '../../lib/db';
const pages = await q("select * from landing_pages order by array_position(array['operations','sponsor-90-days','pmo','integration','si-partners'], slug), slug");
const p = pages.find((x) => x.slug === Astro.url.searchParams.get('page')) || pages[0];
---
<Dashboard title="Copy, booking link, lead magnet" eyebrow="Landing pages" active="pages">
  <section class="two">
    <div class="side-list">
      {pages.map((x) => <a href={'/dashboard/pages?page=' + x.slug} aria-current={x.slug === p?.slug ? 'page' : undefined}><strong>{x.eyebrow}</strong><small>/for/{x.slug}{x.published ? '' : ' · draft'}</small></a>)}
      <p class="side-note">Wording shared by all five pages (step names, buttons, the thank-you text) is under Website content → Landing pages (shared copy). Questions are in the Form builder.</p>
    </div>
    {p && <div class="panel" style="padding:22px;display:grid;gap:14px">
      <h2 class="ph2">Landing page copy — {p.eyebrow} <small class="faint" style="font-family:var(--sans);font-size:13px">(internal: {p.persona})</small></h2>
      <Editor fields={LANDING_FIELDS} value={p} endpoint="/api/admin/landing" extra={{ slug: p.slug }}>
        <a slot="actions" href={'/for/' + p.slug} target="_blank" rel="noopener" style="font-size:13px;font-weight:600">Preview ↗</a>
      </Editor>
    </div>}
  </section>
</Dashboard>
<script>import '../../scripts/cms';</script>

---
import Dashboard from '../../layouts/Dashboard.astro';
import { q } from '../../lib/db';
const pages = await q("select p.slug, p.eyebrow, (select count(*) from form_questions f where f.page_slug = p.slug and f.step = 2)::int as n from landing_pages p order by array_position(array['operations','sponsor-90-days','pmo','integration','si-partners'], p.slug), p.slug");
const slug = pages.some((p) => p.slug === Astro.url.searchParams.get('page')) ? Astro.url.searchParams.get('page')! : pages[0]?.slug;
const qs = slug ? await q('select key, label, type, options, required from form_questions where page_slug = $1 and step = 2 order by position', [slug]) : [];
const label = pages.find((p) => p.slug === slug)?.eyebrow || '';
const TYPES: [string, string][] = [['text', 'Short text'], ['textarea', 'Long text'], ['email', 'Email'], ['number', 'Number'], ['date', 'Date'], ['select', 'Dropdown'], ['radio', 'Single choice']];
---
<Dashboard title="Questions per landing page" eyebrow="Form builder" active="forms">
  <section class="two">
    <div class="side-list">
      {pages.map((p) => <a href={'/dashboard/forms?page=' + p.slug} aria-current={p.slug === slug ? 'page' : undefined}><strong>{p.eyebrow}</strong><small>{p.n} questions in step 2</small></a>)}
      <p class="side-note">Step 1 (name, email) and step 3 (the grid) are fixed. Everything else here is yours to add, reorder, require or remove. Changes publish instantly to the live page.</p>
    </div>
    {slug && <div class="panel" style="padding:22px;display:grid;gap:14px" id="fb" data-slug={slug} data-questions={JSON.stringify(qs.map((x) => ({ ...x, options: x.options || [] })))} data-types={JSON.stringify(TYPES)}>
      <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap"><h2 class="ph2">Step 2 · Your situation — {label}</h2><a href={'/for/' + slug} target="_blank" rel="noopener" style="font-size:13px;font-weight:600">Preview page ↗</a></div>
      <ol class="fb-list" id="fb-list"></ol>
      <div class="fb-foot"><button type="button" class="dbtn dbtn--ghost" id="fb-add">+ Add question</button><span id="fb-count" class="faint" style="font-size:13px"></span><span id="fb-st" role="status" aria-live="polite" class="faint" style="font-size:13px;margin-left:auto"></span><button type="button" class="dbtn dbtn--teal" id="fb-pub">Publish</button></div>
    </div>}
  </section>
</Dashboard>
<style is:global>
.fb-list{list-style:none;margin:0;padding:0;display:grid;gap:8px}
.fb-q{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;padding:12px 14px;border:1px solid var(--line);border-radius:10px;background:var(--paper)}
.fb-mv{display:grid;gap:2px}.fb-mv button{border:0;background:transparent;cursor:pointer;color:var(--indigo);padding:2px 6px;font-size:12px}.fb-mv button:disabled{opacity:.3;cursor:default}
.fb-q .fb-label{width:100%;min-width:0;padding:8px 10px;border:1px solid rgba(18,15,56,.15);border-radius:6px;background:#fff;font:inherit;font-weight:500}
.fb-meta{display:flex;gap:10px;flex-wrap:wrap;align-items:center;font-size:12.5px;color:var(--muted)}
.fb-meta select{padding:5px 8px;border:1px solid rgba(18,15,56,.15);border-radius:6px;background:#fff;font:inherit;font-size:12.5px}.fb-meta label{display:inline-flex;gap:6px;align-items:center;cursor:pointer}
.fb-opts{display:flex;gap:6px;flex-wrap:wrap;align-items:center;flex:1;min-width:180px}
.fb-opt{display:inline-flex;align-items:center;border:1px solid rgba(18,15,56,.15);border-radius:6px;background:#fff}.fb-opt input{border:0;background:transparent;font:inherit;font-size:12.5px;padding:5px 2px 5px 8px;width:auto;min-width:60px;field-sizing:content;max-width:240px}.fb-opt button{border:0;background:none;color:var(--faint);cursor:pointer;padding:0 6px;font-size:14px;line-height:1}.fb-opt button:hover{color:#B3261E}
.fb-addopt{border:1px dashed rgba(18,15,56,.25);background:#fff;border-radius:6px;padding:4px 8px;font-size:12px;cursor:pointer;color:var(--navy)}
.fb-rm{border:0;background:transparent;cursor:pointer;color:#B3261E;font-size:13px;font-weight:600}
.fb-foot{display:flex;gap:10px;flex-wrap:wrap;align-items:center;padding-top:6px;border-top:1px solid rgba(18,15,56,.08)}
</style>
<script>
  import { api } from '../../scripts/dashboard';
  const box = document.getElementById('fb');
  if (box) {
    type Q = { key: string; label: string; type: string; required: boolean; options: string[] };
    let qs: Q[] = JSON.parse(box.dataset.questions || '[]'); const types: [string, string][] = JSON.parse(box.dataset.types || '[]');
    const list = document.getElementById('fb-list')!, count = document.getElementById('fb-count')!, st = document.getElementById('fb-st')!;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const keyFor = (label: string) => { let base = label.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '').slice(0, 30) || 'question'; if (/^(name|email|company|title|grid|website|page_slug)$/.test(base)) base += '_2'; let k = base, n = 2; while (qs.some((x) => x.key === k)) k = `${base}_${n++}`; return k; };
    const dirty = () => { st.textContent = 'Unpublished changes'; };
    const render = () => {
      list.innerHTML = qs.map((x, i) => `<li class="fb-q" data-i="${i}">
        <div class="fb-mv"><button type="button" data-up aria-label="Move up" ${i === 0 ? 'disabled' : ''}>▲</button><button type="button" data-down aria-label="Move down" ${i === qs.length - 1 ? 'disabled' : ''}>▼</button></div>
        <div style="display:grid;gap:6px;min-width:0"><input class="fb-label" value="${esc(x.label)}" aria-label="Question label" data-f="label" />
          <div class="fb-meta"><select data-f="type" aria-label="Question type">${types.map(([v, l]) => `<option value="${v}" ${v === x.type ? 'selected' : ''}>${l}</option>`).join('')}</select>
            <label><input type="checkbox" data-f="required" ${x.required ? 'checked' : ''} />Required</label>
            ${x.type === 'select' || x.type === 'radio' ? `<span class="fb-opts" aria-label="Options">${x.options.map((o, j) => `<span class="fb-opt"><input value="${esc(o)}" data-opt="${j}" aria-label="Option ${j + 1}" /><button type="button" data-rmopt="${j}" aria-label="Remove option">×</button></span>`).join('')}<button type="button" class="fb-addopt" data-addopt>+ option</button></span>` : ''}
          </div></div>
        <button type="button" class="fb-rm" data-rm aria-label="Remove question">Remove</button></li>`).join('');
      count.textContent = `${qs.length} questions in step 2 · ${qs.filter((x) => x.required).length} required`;
    };
    list.addEventListener('input', (e) => { const t = e.target as HTMLInputElement; const i = Number(t.closest<HTMLElement>('.fb-q')!.dataset.i);
      if (t.dataset.f === 'label') qs[i].label = t.value; if (t.dataset.opt !== undefined) qs[i].options[Number(t.dataset.opt)] = t.value; dirty(); });
    list.addEventListener('change', (e) => { const t = e.target as HTMLInputElement; const i = Number(t.closest<HTMLElement>('.fb-q')!.dataset.i);
      if (t.dataset.f === 'type') { qs[i].type = t.value; if ((t.value === 'select' || t.value === 'radio') && !qs[i].options.length) qs[i].options = ['', '']; render(); }
      if (t.dataset.f === 'required') { qs[i].required = t.checked; render(); } dirty(); });
    list.addEventListener('click', (e) => { const t = (e.target as HTMLElement).closest('button'); if (!t) return; const i = Number(t.closest<HTMLElement>('.fb-q')!.dataset.i);
      if (t.hasAttribute('data-up') && i > 0) [qs[i - 1], qs[i]] = [qs[i], qs[i - 1]];
      else if (t.hasAttribute('data-down') && i < qs.length - 1) [qs[i + 1], qs[i]] = [qs[i], qs[i + 1]];
      else if (t.hasAttribute('data-rm')) { if (!confirm('Remove this question?')) return; qs.splice(i, 1); }
      else if (t.dataset.rmopt !== undefined) qs[i].options.splice(Number(t.dataset.rmopt), 1);
      else if (t.hasAttribute('data-addopt')) { qs[i].options.push(''); render(); list.querySelector<HTMLInputElement>(`.fb-q[data-i="${i}"] [data-opt="${qs[i].options.length - 1}"]`)?.focus(); dirty(); return; }
      else return;
      render(); dirty(); });
    document.getElementById('fb-add')!.addEventListener('click', () => { qs.push({ key: '', label: 'New question', type: 'text', required: false, options: [] }); render(); dirty(); const inp = list.querySelector<HTMLInputElement>('.fb-q:last-child .fb-label'); inp?.focus(); inp?.select(); });
    document.getElementById('fb-pub')!.addEventListener('click', async () => {
      const out = qs.map((x) => ({ ...x, key: x.key || keyFor(x.label), options: x.type === 'select' || x.type === 'radio' ? x.options.map((o) => o.trim()).filter(Boolean) : [] }));
      st.textContent = 'Publishing…';
      try { await api('forms', 'PUT', { slug: box.dataset.slug, questions: out }); qs = out; st.textContent = 'Published. Live on the page now.'; } catch { st.textContent = ''; }
    });
    addEventListener('beforeunload', (e) => { if (st.textContent === 'Unpublished changes') e.preventDefault(); });
    render();
  }
</script>

---
import Dashboard from '../../layouts/Dashboard.astro';
export const prerender = false;
const sb = Astro.locals.sb;
const { data: pages } = await sb.from('landing_pages').select('slug,eyebrow').order('slug'); const slug = Astro.url.searchParams.get('page') || pages?.[0]?.slug;
const { data: qs } = await sb.from('form_questions').select('*').eq('page_slug', slug).eq('step', 2).order('position'); const label = pages?.find((p) => p.slug === slug)?.eyebrow;
---
<Dashboard title="Questions per landing page" eyebrow="Form builder" active="forms">


<section class="two"><div class="side-list">{(pages || []).map((p) => <a href={'/dashboard/forms?page=' + p.slug} aria-current={p.slug === slug ? 'page' : undefined}><strong style="font-size:14px">{p.eyebrow}</strong><small>/for/{p.slug}</small></a>)}<p class="note" style="margin:12px 2px 0;line-height:1.5">Step 1 (name, email, company, title) and step 3 (the grid) are fixed. Step 2 is yours: add, reorder, require or remove. Saves apply to the live page within a minute.</p></div>
<div class="panel panel--pad" style="display:grid;gap:14px"><div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap"><h2 class="h3" style="font-size:24px">Step 2 · Your situation — {label}</h2><a href={'/for/' + slug} target="_blank" rel="noopener" style="font-size:13px;font-weight:600">Preview page ↗</a></div>
  <ol style="list-style:none;margin:0;padding:0;display:grid;gap:8px">{(qs || []).map((q, i) => <li class="qrow"><div class="mv"><button data-action="patch" data-table="form_questions" data-id={q.id} data-field="position" data-value={i - 1.5} aria-label="Move up">▲</button><button data-action="patch" data-table="form_questions" data-id={q.id} data-field="position" data-value={i + 1.5} aria-label="Move down">▼</button></div>
    <form data-save="form_questions" data-json="options" style="display:grid;gap:6px;min-width:0"><input type="hidden" name="id" value={q.id} /><input name="label" value={q.label} aria-label="Question label" style="font-weight:500" />
      <div class="meta"><select name="type" aria-label="Type">{['text', 'textarea', 'email', 'number', 'date', 'select', 'radio'].map((t) => <option value={t} selected={t === q.type}>{({ text: 'Short text', textarea: 'Long text', email: 'Email', number: 'Number', date: 'Date', select: 'Dropdown', radio: 'Single choice' })[t]}</option>)}</select><label style="display:inline-flex;gap:6px;align-items:center"><input type="checkbox" name="required" checked={q.required} />Required</label><input name="options" value={JSON.stringify(q.options || [])} placeholder='Options as JSON: ["A","B"]' style="flex:1;min-width:180px" /><button class="btn-sm" type="submit" style="padding:6px 10px">Save</button><span role="status" class="note"></span></div></form>
    <button class="rm" data-action="delete" data-table="form_questions" data-id={q.id}>Remove</button></li>)}</ol>
  <form data-save="form_questions" data-method="POST" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;padding-top:6px;border-top:1px solid rgba(18,15,56,.08)"><input type="hidden" name="page_slug" value={slug} /><input type="hidden" name="step" value="2" /><input type="hidden" name="position" value={(qs || []).length} /><input type="hidden" name="type" value="text" /><input name="key" placeholder="key (e.g. budget)" required pattern="[a-z0-9_]+" style="font:inherit;padding:8px 10px;border:1px solid rgba(18,15,56,.15);border-radius:6px" /><input name="label" placeholder="New question label" required style="font:inherit;padding:8px 10px;border:1px solid rgba(18,15,56,.15);border-radius:6px;flex:1;min-width:200px" /><button class="btn-sm" type="submit">+ Add question</button><span role="status" class="note"></span></form>
  <p class="note" style="margin:0">Positions re-sort on save; the public form reads this list live. Server validation uses the same list, so a required question can't be skipped.</p></div></section>
</Dashboard>

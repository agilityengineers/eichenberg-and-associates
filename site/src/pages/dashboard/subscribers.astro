---
import Dashboard from '../../layouts/Dashboard.astro';
import { q } from '../../lib/db';
import { getSettings } from '../../lib/settings';
import { shortDate } from '../../lib/dashboard';
const [subs, s] = await Promise.all([q('select * from subscribers order by created_at desc'), getSettings()]);
const inP = subs.filter((x) => x.in_profile === 'in').length;
const target = s.measures.find((m) => m.key === 'subscribers');
const C: Record<string, string> = { in: 'pill--teal', partner: 'pill--indigo2', unknown: 'pill--grey', out: 'pill--red' };
const L: Record<string, string> = { in: 'In profile', out: 'Out of profile', unknown: 'Unknown', partner: 'Systems Integrator (SI) partner' };
---
<Dashboard title="Newsletter subscribers" eyebrow="Content engine" active="subscribers">
  <div style="display:grid;gap:20px">
    <section class="kpis">
      <div class="kpi kpi--sm"><p class="k">Subscribers</p><p class="v">{subs.length}</p></div>
      <div class="kpi kpi--sm"><p class="k">In target profile</p><p class="v">{inP} <small>/ {target?.target || '150 by year end'}</small></p></div>
      <div class="kpi kpi--sm"><p class="k">From lead magnets</p><p class="v">{subs.filter((x) => x.source && x.source !== 'Insights page').length}</p></div>
    </section>
    <section class="panel" style="overflow:hidden"><div style="overflow-x:auto"><table class="tbl tbl--tight"><thead><tr><th>Email</th><th>Source</th><th>Profile</th><th>Joined</th><th></th></tr></thead><tbody>
      {subs.map((x) => <tr><td>{x.email}</td><td class="muted">{x.source || '—'}</td>
        <td><button class={'pill ' + (C[x.in_profile] || 'pill--grey')} data-action="patch" data-table="subscribers" data-id={x.id} data-field="in_profile" data-cycle="unknown|in|out|partner" data-current={x.in_profile} title="Click to change">{L[x.in_profile] || x.in_profile}</button></td>
        <td class="muted">{shortDate(x.created_at)}</td><td><button class="lnk-rm" style="font-size:12px;font-weight:500" data-action="delete" data-table="subscribers" data-id={x.id} data-confirm={`Remove ${x.email}?`}>Remove</button></td></tr>)}
      {!subs.length && <tr><td colspan="5" style="padding:32px;text-align:center;color:var(--faint)">No subscribers yet. Sign-ups from the Insights page and the landing-page lead magnets appear here.</td></tr>}
    </tbody></table></div>
    <p class="faint" style="padding:14px 18px;margin:0;border-top:1px solid rgba(18,15,56,.08);font-size:13px">Click a profile to cycle it. “In profile” counts toward the subscribers measure on the Overview.</p></section>
  </div>
</Dashboard>

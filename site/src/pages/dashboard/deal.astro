---
import Dashboard from '../../layouts/Dashboard.astro';
import { one, q } from '../../lib/db';
import { getSettings } from '../../lib/settings';
import { GRID_SHORT } from '../../lib/dashboard';
const id = Astro.url.searchParams.get('id') || '';
const d = /^[0-9a-f-]{36}$/.test(id) ? await one('select * from deals where id = $1', [id]) : null;
if (!d) return Astro.redirect('/dashboard/pipeline');
const [partners, s, lead] = await Promise.all([q('select id, firm from partners order by firm'), getSettings(), d.lead_id ? one('select * from leads where id = $1', [d.lead_id]) : null]);
const due = d.next_due ? new Date(d.next_due).toISOString().slice(0, 10) : '';
---
<Dashboard title={d.company} eyebrow="Pipeline · Edit deal" active="pipeline">
  <div class="dlay">
    <form class="panel panel--pad dform" data-save="deals" style="min-width:0"><input type="hidden" name="id" value={d.id} />
      <div class="dgrid">
        <div class="cms-f"><label for="d-co">Company</label><input id="d-co" name="company" class="cms-v" value={d.company} required /></div>
        <div class="cms-f"><label for="d-ct">Contact</label><input id="d-ct" name="contact" class="cms-v" value={d.contact} /></div>
        <div class="cms-f"><label for="d-st">Stage</label><select id="d-st" name="stage" class="cms-v">{s.stages.map((x, i) => <option value={i} selected={i === d.stage}>{x.name}</option>)}</select></div>
        <div class="cms-f"><label for="d-of">Offer</label><input id="d-of" name="offer" class="cms-v" list="offers" value={d.offer} /><datalist id="offers">{s.lists.offers.map((o) => <option value={o} />)}</datalist></div>
        <div class="cms-f"><label for="d-fee">Fee estimate ($)</label><input id="d-fee" name="fee_estimate" type="number" min="0" step="500" class="cms-v" value={d.fee_estimate ?? ''} /></div>
        <div class="cms-f"><label for="d-gl">Go-live</label><input id="d-gl" name="go_live" class="cms-v" value={d.go_live} placeholder="e.g. Jan 12, 2027" /></div>
        <div class="cms-f"><label for="d-src">Source</label><input id="d-src" name="source" class="cms-v" list="sources" value={d.source} /><datalist id="sources">{s.lists.sources.map((o) => <option value={o} />)}</datalist></div>
        <div class="cms-f"><label for="d-pa">SI partner</label><select id="d-pa" name="partner_id" class="cms-v"><option value="">—</option>{partners.map((p) => <option value={p.id} selected={p.id === d.partner_id}>{p.firm}</option>)}</select></div>
        <div class="cms-f"><label for="d-gr">Grid</label><select id="d-gr" name="grid" class="cms-v"><option value="">—</option>{Object.entries(GRID_SHORT).map(([k, v]) => <option value={k} selected={k === d.grid}>{v}</option>)}</select></div>
        <div class="cms-f"><label for="d-bd">BD hours spent</label><input id="d-bd" name="bd_hours" type="number" min="0" step="0.5" class="cms-v" value={Number(d.bd_hours)} /><span class="cms-hint">Increases are logged as BD time for the week.</span></div>
        <div class="cms-f"><label for="d-nx">Next step</label><input id="d-nx" name="next_step" class="cms-v" value={d.next_step} /></div>
        <div class="cms-f"><label for="d-du">Due</label><input id="d-du" name="next_due" type="date" class="cms-v" value={due} /></div>
        <div class="cms-f" style="grid-column:1/-1"><label for="d-no">Notes</label><textarea id="d-no" name="notes" rows="5" class="cms-v">{d.notes}</textarea></div>
      </div>
      <div class="cms-save"><a href="/dashboard/pipeline" class="faint" style="font-size:13px">← Back to pipeline</a><button type="button" class="lnk-rm" data-action="delete" data-table="deals" data-id={d.id} data-confirm="Delete this deal? The lead stays in the inbox." data-redirect="/dashboard/pipeline">Delete deal</button><span role="status" class="cms-st"></span><button class="dbtn dbtn--teal" type="submit">Save</button></div>
    </form>
    {lead && <aside class="panel panel--pad" style="display:grid;gap:10px;font-size:14px"><h2 class="ph2" style="font-size:20px">From the {lead.source === 'contact' ? 'contact form' : 'landing page'}</h2><p style="margin:0"><strong>{lead.name}</strong>{lead.title && <>, {lead.title}</>}<br /><a href={'mailto:' + lead.email}>{lead.email}</a></p>{lead.grid_result && <p style="margin:0" class="muted">Grid: {lead.grid_result}</p>}<dl style="margin:0;display:grid;gap:6px">{Object.entries(lead.answers || {}).map(([k, v]) => <div><dt class="faint" style="font-size:12px">{k}</dt><dd style="margin:0">{String(v)}</dd></div>)}</dl></aside>}
  </div>
</Dashboard>
<style>
.dgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px}
.dform .cms-save{background:#fff}
.dlay{display:grid;gap:20px;grid-template-columns:minmax(0,2fr) minmax(240px,1fr);align-items:start}@media (max-width:1000px){.dlay{grid-template-columns:1fr}}
</style>

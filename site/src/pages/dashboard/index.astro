---
import Dashboard from '../../layouts/Dashboard.astro';
export const prerender = false;
const sb = Astro.locals.sb;
const [{ data: deals }, { data: partners }, { data: subs }, { data: leads }, { data: measures }, { data: acts }] = await Promise.all([sb.from('deals').select('*'), sb.from('partners').select('status'), sb.from('subscribers').select('in_profile'), sb.from('leads').select('id,deal_id,created_at'), sb.from('measures').select('*'), sb.from('activities').select('hours,at')]);
const q = new Date(); q.setMonth(q.getMonth() - 3);
const actual: Record<string, number> = { exploration: (leads || []).filter((l) => new Date(l.created_at) > q).length, partners: (partners || []).filter((p) => p.status === 2).length, assess_to_anchor: 0, role_readiness: (deals || []).filter((d) => d.stage === 'Continuation' && /role/i.test(d.offer || '')).length, subscribers: (subs || []).filter((s) => s.in_profile === 'in').length };
const proposed = (deals || []).reduce((a, d) => a + Number(d.fee_estimate || 0), 0); const wk = new Date(); wk.setDate(wk.getDate() - 7); const hours = (acts || []).filter((a) => new Date(a.at) > wk).reduce((a, x) => a + Number(x.hours), 0);
const fmt = (n: number) => '$' + Math.round(n / 1000) + 'K';
---
<Dashboard title="What 2027 needs to prove" eyebrow="Measures" active="overview">


<section class="kpis"><div class="kpi"><p class="k">Kept, 2027 plan</p><p class="v">$380K</p><p class="s">From the growth strategy</p></div><div class="kpi"><p class="k">Proposed in pipeline</p><p class="v">{fmt(proposed)}</p><p class="s">{(deals || []).length} deals across five stages</p></div><div class="kpi"><p class="k">New leads</p><p class="v">{(leads || []).filter((l) => !l.deal_id).length}</p><p class="s">Not yet in the pipeline</p></div><div class="kpi"><p class="k">BD hours, 7 days</p><p class="v">{hours}</p><p class="s">Target 20–25 between engagements; tripwire under 8</p></div></section>
<section class="panel panel--pad" style="margin-top:20px"><h2 class="h3" style="font-size:26px;margin-bottom:6px">Measures vs targets</h2><p class="note" style="margin:0 0 16px">Targets from the strategy deck. Actuals from leads, deals, partners and subscribers.</p>
  {(measures || []).map((m) => <div style="display:grid;grid-template-columns:minmax(160px,1.4fr) minmax(120px,1fr) minmax(140px,2fr);gap:16px;align-items:center;padding:12px 0;border-top:1px solid rgba(18,15,56,.08)"><span style="font-weight:500">{m.label}</span><span class="note">Target: {m.target}</span><div style="display:flex;align-items:center;gap:12px"><div class="bar" style="flex:1"><div style={`width:${Math.min(100, Math.round((actual[m.key] / Number(m.target_num || 1)) * 100))}%`}></div></div><strong style="min-width:48px;text-align:right">{actual[m.key]}</strong></div></div>)}
</section>
<section style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;margin-top:20px"><div class="panel panel--pad" style="background:var(--indigo);color:#fff;border:0"><h2 class="h3" style="font-size:24px;margin-bottom:14px">Five learning questions</h2><ol style="margin:0;padding-left:20px;display:grid;gap:8px;font-size:15px"><li>Do assessments lead to anchors?</li><li>Does Role Readiness sell when it’s attached?</li><li>Where is the mid-market anchor price ceiling?</li><li>What does the toolkit actually save in hours?</li><li>Which channels produce wins?</li></ol></div>
<div class="panel panel--pad"><h2 class="h3" style="font-size:24px;margin-bottom:14px">Bridge-work tripwires</h2><ul style="margin:0;padding:0;list-style:none;display:grid;gap:10px;font-size:14px"><li><strong>Business development under 8 hours a week for a month</strong><br /><span class="note">{hours}h this week</span></li><li><strong>Bridge income above a third of the year’s revenue</strong><br /><span class="note">Log bridge invoices in Activities (kind = bridge)</span></li><li><strong>Six months on one engagement with no move to fixed fee</strong></li></ul></div></section>
</Dashboard>

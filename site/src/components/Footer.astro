---
import site from '../content/settings/site.json';
const year = new Date().getFullYear();
---
<footer class="dark ft">
  <img src="/images/mark-half-right-teal.png" alt="" aria-hidden="true" class="ft__mark" />
  <div class="wrap ft__grid">
    <div class="ft__brand">
      <img src="/images/logo-white.png" alt="Eichenberg & Associates" width="160" height="116" />
      <p>Trained isn't ready. We make sure your people can actually perform on day one.</p>
      <p class="label" style="color:var(--teal)">WBENC certified</p>
    </div>
    <nav aria-label="Footer services"><h2 class="ft__h">Services</h2><ul><li><a href="/services/project-role-readiness">Project Role Readiness</a></li><li><a href="/services/ocm-leadership">OCM Leadership</a></li><li><a href="/services/readiness-assessment">Readiness Assessment</a></li><li><a href="/partners">For Systems Integrator (<abbr title="Systems Integrator">SI</abbr>) partners</a></li></ul></nav>
    <nav aria-label="Footer firm"><h2 class="ft__h">Firm</h2><ul><li><a href="/who-we-serve">Who we serve</a></li><li><a href="/about">About</a></li><li><a href="/insights">Insights</a></li><li><a href="/contact">Contact</a></li></ul></nav>
    <div><h2 class="ft__h">Contact</h2><ul><li><a href={`mailto:${site.email}`}>{site.email}</a></li><li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li><li><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a></li></ul></div>
  </div>
  <div class="wrap ft__bar"><span>© {year} Eichenberg &amp; Associates</span><span style="display:flex;gap:16px"><a href="/privacy">Privacy Policy</a><a href="/terms">Terms of Service</a></span></div>
</footer>
<style>
.ft{border-top:1px solid rgba(255,255,255,.1);position:relative;overflow:hidden}
.ft__mark{position:absolute;right:-2%;bottom:-30%;height:120%;width:auto;opacity:.08;pointer-events:none}
.ft__grid{position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:40px;padding-top:56px;padding-bottom:32px}
.ft__brand{display:grid;gap:16px;align-content:start}.ft__brand img{width:160px}.ft__brand p{margin:0;font-size:15px;line-height:1.5;color:rgba(255,255,255,.72);max-width:30ch}
.ft__h{margin:0 0 14px;font-size:12px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:rgba(255,255,255,.6)}
.ft ul{list-style:none;margin:0;padding:0;display:grid;gap:10px;font-size:15px}.ft a{color:#fff}.ft a:hover{color:var(--teal)}
.ft__bar{position:relative;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;padding-top:20px;padding-bottom:32px;border-top:1px solid rgba(255,255,255,.1);font-size:13px;color:rgba(255,255,255,.6)}.ft__bar a{color:rgba(255,255,255,.6)}
</style>

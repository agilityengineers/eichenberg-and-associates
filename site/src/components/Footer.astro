---
import { setting } from '../lib/content';
import { si } from '../lib/si';
const site = await setting('site'); const f = site.footer;
const year = new Date().getFullYear();
type L = { label: string; href: string };
---
<footer class="dark ft">
  <img src="/images/mark-half-right-teal.png" alt="" aria-hidden="true" class="ft__mark" />
  <div class="wrap ft__grid">
    <div class="ft__brand">
      <img src="/images/logo-white.png" alt={site.name} width="160" height="116" />
      <p>{f.tagline}</p>
      <p class="label" style="color:var(--teal)">{site.certification}</p>
    </div>
    <nav aria-label="Footer services"><h2 class="ft__h">{f.servicesHeading}</h2><ul>{f.services.map((l: L) => <li><a href={l.href} set:html={si(l.label)} /></li>)}</ul></nav>
    <nav aria-label="Footer firm"><h2 class="ft__h">{f.firmHeading}</h2><ul>{f.firm.map((l: L) => <li><a href={l.href} set:html={si(l.label)} /></li>)}</ul></nav>
    <div><h2 class="ft__h">{f.contactHeading}</h2><ul><li><a href={`mailto:${site.email}`}>{site.email}</a></li><li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li><li><a href={site.linkedin} target="_blank" rel="noopener">{f.linkedinLabel}</a></li></ul></div>
  </div>
  <div class="wrap ft__bar"><span>© {year} {site.name}</span><span style="display:flex;gap:16px"><a href="/privacy">{f.privacyLabel}</a><a href="/terms">{f.termsLabel}</a></span></div>
</footer>
<style>
.ft{border-top:1px solid rgba(255,255,255,.1);position:relative;overflow:hidden}
.ft__mark{position:absolute;right:-2%;bottom:-30%;height:120%;width:auto;opacity:.08;pointer-events:none}
.ft__grid{position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:40px;padding-top:56px;padding-bottom:32px}
.ft__brand{display:grid;gap:16px;align-content:start}.ft__brand img{width:160px}.ft__brand p{margin:0;font-size:15px;line-height:1.5;color:rgba(255,255,255,.72);max-width:30ch}
.ft__brand p.label{font-size:12px;color:var(--teal)}
.ft__h{margin:0 0 14px;font-size:12px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:rgba(255,255,255,.6)}
.ft ul{list-style:none;margin:0;padding:0;display:grid;gap:10px;font-size:15px}.ft a{color:#fff}.ft a:hover{color:var(--teal)}
.ft__bar{position:relative;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;padding-top:20px;padding-bottom:32px;border-top:1px solid rgba(255,255,255,.1);font-size:13px;color:rgba(255,255,255,.6)}.ft__bar a{color:rgba(255,255,255,.6)}
</style>

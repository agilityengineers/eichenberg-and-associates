---
// Merged feed posts (the site's own Insights posts + RSS feeds), newest first. Rendered on the server, then refreshed
// in the browser from /api/feed when the list has changed. `images` shows each post's picture when the feed has one.
import { allPosts, fmtDate } from '../lib/feeds';
import { setting } from '../lib/content';
interface Props { limit?: number; variant?: 'cards' | 'list'; images?: boolean }
const { limit = 3, variant = 'cards', images = false } = Astro.props;
const { items, errors } = await allPosts(limit);
const feeds = await setting('feeds');
const Title = variant === 'list' ? 'h2' : 'h3';
---
<div class={'feed feed--' + variant} data-feed data-limit={limit} data-variant={variant} data-images={images ? '1' : undefined}>
  {items.map((p, i) => { const img = images && p.image; const featured = variant === 'list' && i === 0 && !!img; return (
    <a href={p.link} target={p.local ? undefined : '_blank'} rel={p.local ? undefined : 'noopener'} class:list={['feed__item', 'rise', { 'feed__item--img': !!img, 'feed__item--featured': featured }]} style={`animation-delay:${Math.min(i, 8) * 0.08}s`}>
      {img && <span class="feed__media"><img src={p.image} alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" /></span>}
      <span class="feed__body">
        <span class="feed__tag">{p.tag || p.source}</span>
        <Title class="feed__title">{p.title}</Title>
        {p.excerpt && <span class="feed__x">{p.excerpt}</span>}
        <span class="feed__meta">{fmtDate(p.date) && <time datetime={p.date}>{fmtDate(p.date)}</time>}{!p.local && <>{fmtDate(p.date) && ' · '}{p.source}</>}</span>
      </span>
    </a>); })}
  {!items.length && <p class="note feed__empty">{feeds.emptyText}</p>}
</div>
{(import.meta.env.DEV || Astro.locals.user) && errors.length > 0 && <p class="note" style="margin:10px 0 0">Feed problems (only you can see this): {errors.join(' · ')}</p>}
<style is:global>
.feed--cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px}.feed--list{display:grid;gap:14px}
.feed__item{display:grid;align-content:start;background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:26px 28px;color:var(--ink);transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s}
.feed__item:hover{transform:translateY(-4px);box-shadow:0 20px 36px rgba(18,15,56,.1);color:var(--ink)}
.feed__item.rise{animation-fill-mode:backwards}   /* `both` would pin transform:none after the entrance and cancel the hover lift */
.feed__body{display:grid;gap:10px;align-content:start;min-width:0}
.feed__tag{font-size:12px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--teal)}
.feed__title{margin:0;font-family:var(--serif);font-weight:400;font-size:24px;line-height:1.15;text-wrap:balance}
.feed__x{font-size:15px;line-height:1.5;color:var(--muted)}
.feed__meta{font-size:13px;color:var(--faint)}
.feed__media{position:relative;display:block;overflow:hidden;background:var(--paper)}
.feed__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.7,.2,1)}
.feed__item:hover .feed__media img{transform:scale(1.03)}
/* cards (home): picture on top */
.feed--cards .feed__item--img{padding:0}.feed--cards .feed__media{aspect-ratio:16/9;border-radius:9px 9px 0 0}.feed--cards .feed__item--img .feed__body{padding:22px 28px 26px}
/* list (Insights page): picture beside the text; the newest post is featured with a full-width picture */
.feed--list .feed__item{background:#fff;padding:28px 32px}.feed--list .feed__title{font-size:28px;line-height:1.1}.feed--list .feed__meta{font-size:14px}
.feed--list .feed__item--img{padding:0;grid-template-columns:minmax(160px,220px) minmax(0,1fr)}
/* No aspect-ratio on the side picture: it stretches to the row height, and an aspect ratio would then set its width from that height and spill over the text. */
.feed--list .feed__item--img .feed__media{align-self:stretch;min-height:190px;border-radius:9px 0 0 9px}
.feed--list .feed__item--img .feed__body{padding:24px 28px 26px}
.feed--list .feed__item--img .feed__title{font-size:24px;line-height:1.15}
.feed--list .feed__item--featured{grid-template-columns:1fr}
.feed--list .feed__item--featured .feed__media{aspect-ratio:2/1;min-height:0;border-radius:9px 9px 0 0}
.feed--list .feed__item--featured .feed__body{padding:28px 32px 32px}
.feed--list .feed__item--featured .feed__title{font-size:clamp(28px,3.2vw,38px);line-height:1.08}
.feed--list .feed__item--featured .feed__x{font-size:16px;line-height:1.55}
@media (max-width:600px){.feed--list .feed__item--img{grid-template-columns:1fr}.feed--list .feed__item--img .feed__media{aspect-ratio:16/9;min-height:0;border-radius:9px 9px 0 0}.feed--list .feed__item--featured .feed__media{aspect-ratio:16/9}}
@media (prefers-reduced-motion:reduce){.feed__item:hover .feed__media img{transform:none}}
</style>
<script>
  // Refresh from the live merged feed when it differs from what the server rendered (new posts since its cache).
  document.querySelectorAll<HTMLElement>('[data-feed]').forEach(async (el) => {
    try {
      const r = await fetch('/api/feed?limit=' + el.dataset.limit); const { items } = await r.json(); if (!items?.length) return;
      const shown = [...el.querySelectorAll<HTMLAnchorElement>('a.feed__item')].map((a) => a.getAttribute('href')).join('\n');
      if (shown === items.map((p: any) => p.link).join('\n')) return;
      const list = el.dataset.variant === 'list', images = el.dataset.images === '1', tag = list ? 'h2' : 'h3';
      const fmt = (d: string) => { const x = new Date(d); return isNaN(+x) ? '' : x.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }); };
      const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
      const safe = (u: unknown) => (/^(https?:|\/)/.test(String(u)) ? String(u) : '');
      el.innerHTML = items.map((p: any, i: number) => { const img = images ? safe(p.image) : '', featured = list && i === 0 && img, date = fmt(p.date);
        return `<a href="${esc(safe(p.link) || '#')}" ${p.local ? '' : 'target="_blank" rel="noopener"'} class="feed__item${img ? ' feed__item--img' : ''}${featured ? ' feed__item--featured' : ''}">${img ? `<span class="feed__media"><img src="${esc(img)}" alt="" loading="lazy" decoding="async"></span>` : ''}<span class="feed__body"><span class="feed__tag">${esc(p.tag || p.source)}</span><${tag} class="feed__title">${esc(p.title)}</${tag}>${p.excerpt ? `<span class="feed__x">${esc(p.excerpt)}</span>` : ''}<span class="feed__meta">${date ? `<time datetime="${esc(p.date)}">${esc(date)}</time>` : ''}${p.local ? '' : `${date ? ' · ' : ''}${esc(p.source)}`}</span></span></a>`; }).join('');
    } catch {} });
</script>

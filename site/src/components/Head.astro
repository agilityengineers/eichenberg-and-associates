---
// <head> shared by the public site and the landing pages: SEO, Open Graph, JSON-LD, fonts, analytics.
import { setting } from '../lib/content';
import { siteUrl } from '../lib/env';
import { analytics } from '../lib/analytics';
interface Props { title: string; description: string; image?: string; type?: string; noindex?: boolean; jsonLd?: Record<string, unknown> | Record<string, unknown>[] }
const { title, description, image = '/images/og-default.png', type = 'website', noindex = false, jsonLd } = Astro.props;
const site = await setting('site');
const base = siteUrl();
const canonical = base + (Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, ''));
const fullTitle = title.includes('Eichenberg') ? title : `${title} · ${site.name}`;
const org = { '@context': 'https://schema.org', '@type': 'ProfessionalService', name: site.name, url: base, email: site.email, telephone: site.phone, description: site.description, logo: base + '/images/logo-color.png', sameAs: [site.linkedin], areaServed: 'US', knowsAbout: ['Organizational change management', 'ERP go-live readiness', 'Merger integration'] };
const ld: Record<string, unknown>[] = [org, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
const ga = await analytics();
// Consent Mode: with the banner on, analytics cookies stay off until the visitor accepts (the choice is in localStorage).
// Advertising signals are always denied. ga.gaId is validated in lib/analytics.ts, so it is safe to inline.
const gtag = `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}var c=null;try{c=localStorage.getItem('ea_consent')}catch(e){}gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:${ga.banner ? "c==='granted'?'granted':'denied'" : "'granted'"}});gtag('js',new Date());gtag('config','${ga.gaId}');`;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex,nofollow" /> : <link rel="canonical" href={canonical} />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap.xml" />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image.startsWith('http') ? image : base + image} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content="#120F38" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300;1,6..72,400&family=Albert+Sans:wght@400;500;600;700&family=Poppins:wght@500;600&display=swap" rel="stylesheet" />
<script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
{ga.verification && <meta name="google-site-verification" content={ga.verification} />}
{ga.gaId && <script is:inline set:html={gtag} />}
{ga.gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga.gaId}`}></script>}
